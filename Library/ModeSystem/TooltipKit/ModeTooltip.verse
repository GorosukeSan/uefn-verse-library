ModeCategory<public><localizes>:message = "Mode"
ModeTitleToolTip<public><localizes>:message = "The mode name shown on screen."
ModeSelectedModeToolTip<public><localizes>:message = "The condition is satisfied when this mode (an entity with game_mode_component) is selected."
ModeOrderToolTip<public><localizes>:message = "Position among the candidates. Modes are listed from the smallest number. On a tied vote the mode with the smaller number wins."
ModeActiveOnBeginToolTip<public><localizes>:message = "When on, modes can be selected from the start of the game (start of the simulation). When off, from the activation signal (in a game sequence, when this node is entered)."
ModeAllowReselectToolTip<public><localizes>:message = "When off, the first decided mode stays. When on, a different mode can be selected later."
ModeVoteMajorityEndsToolTip<public><localizes>:message = "When off, the mode with the most votes is decided once everyone has voted. When on, it is decided as soon as a majority voted for the same mode."
