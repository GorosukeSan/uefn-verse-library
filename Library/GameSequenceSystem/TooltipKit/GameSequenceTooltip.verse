GameSequenceCategory<public><localizes>:message = "ゲームの流れ"
FirstNodeToolTip<public><localizes>:message = "最初に入るノード（game_node_component を付けた entity）を選びます。空のときは、子のノードのうち「順番」の数字が一番小さいものから始めます。"
TransitionCategory<public><localizes>:message = "次へ進む"
TransitionTargetToolTip<public><localizes>:message = "条件を満たしたときに進むノード（game_node_component を付けた entity）を選びます。空にすると、ここでゲームの流れを終えます。条件はこの entity の子に置きます（無ければすぐに進みます）。"
TransitionPriorityToolTip<public><localizes>:message = "同じノードに「次へ進む」が複数あり、同時に条件を満たしたとき、数字の大きいほうを優先します。"
TransitionTargetCategory<public><localizes>:message = "行き先"
TransitionPriorityCategory<public><localizes>:message = "優先度"
SequenceStartOnRoundStartToolTip<public><localizes>:message = "オンなら、ラウンドの開始でゲームの流れを始め、ラウンドの終わりで止めます。オフならラウンドを見ません（下の「開始時に始める」か、コードの Start で始めます）。"
SequenceStartOnBeginToolTip<public><localizes>:message = "オンなら、ゲームの開始（シミュレーションの開始）でゲームの流れを始めます。"
NodeOrderToolTip<public><localizes>:message = "ゲームの流れの「最初のノード」が空のときに、最初に入るノードを選ぶ順番です。数字の小さいノードから始めます。"
SequenceStartOnActivateToolTip<public><localizes>:message = "オンなら、起動の合図（親のノードに入ったとき・ラウンドの始まりの合図など）でゲームの流れを始め、停止の合図で止めます。受けた合図は配下のノードには届けません。同じレベルにいくつもゲームを置くときは、上の「ラウンドの開始で始める」をオフにしてこちらを使います。"
