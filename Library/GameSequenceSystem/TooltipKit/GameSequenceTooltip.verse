GameSequenceCategory<public><localizes>:message = "Game Flow"
FirstNodeToolTip<public><localizes>:message = "The node entered first (an entity with game_node_component). When empty, starts from the child node with the smallest 'Order' number."
TransitionCategory<public><localizes>:message = "Transition"
TransitionTargetToolTip<public><localizes>:message = "The node (an entity with game_node_component) to advance to when the conditions are satisfied. Leave it empty to end the game flow here. Conditions go on the children of this entity (without any, it advances immediately)."
TransitionPriorityToolTip<public><localizes>:message = "When the same node has several 'Transition's whose conditions are satisfied at the same time, the one with the larger number wins."
TransitionTargetCategory<public><localizes>:message = "Target"
TransitionPriorityCategory<public><localizes>:message = "Priority"
SequenceStartOnRoundStartToolTip<public><localizes>:message = "When on, starts the game flow at round start and stops it at round end. When off, rounds are ignored (start with 'Start On Begin' below or with Start from code)."
SequenceStartOnBeginToolTip<public><localizes>:message = "When on, starts the game flow at the start of the game (the start of the simulation)."
NodeOrderToolTip<public><localizes>:message = "The order used to pick the first node when the game flow's 'First Node' is empty. Starts from the node with the smallest number."
SequenceStartOnActivateToolTip<public><localizes>:message = "When on, starts the game flow on the activation signal (the parent node entered, the round start signal, etc.) and stops it on the deactivation signal. The received signal is not delivered to the nodes below. With several games in the same level, turn off 'Start On Round Start' above and use this."
