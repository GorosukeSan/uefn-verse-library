JetpackCategory<public><localizes>:message = "Jetpack"
JetpackBoostSpeedToolTip<public><localizes>:message = "The speed at the moment of launch with a x1 charge (centimeters per second). It then falls to 0 over Boost Duration Seconds. When the charge makes the distance N times, this speed and the duration are each multiplied by sqrt(N)."
JetpackBoostDurationToolTip<public><localizes>:message = "The seconds from launch until the speed reaches 0 with a x1 charge. After that the player falls normally."
JetpackBoostEaseExponentToolTip<public><localizes>:message = "The strength of the launch easing. The speed falls as initial speed x (1 - elapsed / duration) to this power. 0 keeps the same speed, 1 decreases linearly, and larger values start fast and end slow (the launch distance gets shorter)."
JetpackBoostPitchToolTip<public><localizes>:message = "The vertical angle of the launch direction (degrees). 90 is straight up, 0 horizontal, -90 straight down. The launch goes in this direction regardless of the vertical view direction."
JetpackBoostYawToolTip<public><localizes>:message = "The horizontal angle of the launch direction (degrees). 0 is straight ahead of the player, positive is right, negative is left, 180 is behind. Not used when the vertical angle is 90 (straight up)."
JetpackMinChargeSecondsToolTip<public><localizes>:message = "Charges up to this many seconds keep the launch distance at x1 (even a momentary press launches)."
JetpackMaxChargeSecondsToolTip<public><localizes>:message = "Charging up to this many seconds gives the maximum launch distance (x Max Charge Multiplier) and consumes energy at that moment. Holding longer keeps hovering at maximum, and releasing launches."
JetpackMaxChargeMultiplierToolTip<public><localizes>:message = "The launch distance multiplier at full charge. From Min Charge Seconds to Max Charge Seconds it grows linearly from x1 to this multiplier."
JetpackBoostEnergyCostToolTip<public><localizes>:message = "The energy consumed per launch. Consumed the moment the charge reaches maximum, or the moment of release if earlier. Launching works even when the remainder is short, and the energy goes to 0. At 0, charging is not possible. Without energy (the energy_component of this entity or a child, otherwise the player's) nothing is consumed."
JetpackChargeLiftToolTip<public><localizes>:message = "The height (centimeters) the position is lifted directly when charging starts (velocity and forces have no effect on the ground, so the player is lifted first)."
JetpackChargeRiseSpeedToolTip<public><localizes>:message = "The speed (centimeters per second) of rising while hovering during the charge. No horizontal movement. 0 holds the height."
JetpackGlideEnergyPerSecondToolTip<public><localizes>:message = "The energy consumed per second while holding the button to limit the fall speed after a launch until landing (only while in the air). Decreases every frame by the elapsed time."
JetpackGlideMaxFallSpeedToolTip<public><localizes>:message = "While gliding, the fall speed (centimeters per second) is limited to this value. 0 holds the height."
JetpackRemoveItemWhenEmptyToolTip<public><localizes>:message = "When on, if this ability is placed on an item, the whole item disappears when the energy reaches 0 (after the flight ends if mid-flight). Not used when not an item (charging is just impossible while at 0)."
JetpackBoostActionToolTip<public><localizes>:message = "The action (Input Action) pressed in the air to charge and released to launch. After a launch until landing, holding it limits the fall speed. The default is Jump."
JetpackBoostMappingToolTip<public><localizes>:message = "The key mapping (Input Mapping) enabled while granted. Choose one containing the action above. The default is TraversalMapping (movement controls)."
JetpackRemoveMappingToolTip<public><localizes>:message = "When on, removes the key mapping above on revoke (for an item, when unequipped). Turn it on only when a mapping dedicated to this ability is chosen. Turning it on with the default TraversalMapping disables movement controls too."
JetpackDirectionCategory<public><localizes>:message = "Launch Direction"
JetpackLaunchCategory<public><localizes>:message = "Launch"
JetpackChargeCategory<public><localizes>:message = "Charge"
JetpackGlideCategory<public><localizes>:message = "Glide"
JetpackEnergyCategory<public><localizes>:message = "Energy"
JetpackInputCategory<public><localizes>:message = "Input"
