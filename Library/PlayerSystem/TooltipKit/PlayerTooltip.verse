PlayerCategory<public><localizes>:message = "プレイヤー"
MinPlayerCountToolTip<public><localizes>:message = "参加しているプレイヤーがこの人数以上になると、条件を満たします。"
AttachCategory<public><localizes>:message = "プレイヤーに付ける"
AttachPrefabToolTip<public><localizes>:message = "プレイヤーの体に付ける entity（prefab）です。体と一緒に動きます。"
AttachOffsetToolTip<public><localizes>:message = "体の原点からのずらし（センチメートル。前・左・上）です。既定は真上に 200"
AttachVisibilityToolTip<public><localizes>:message = "だれに見せるかです。Everyone は全員、OwnerOnly は付けた本人だけ、OthersOnly は本人以外。既定 Everyone"
AttachEveryoneToolTip<public><localizes>:message = "オンなら、起動したら全員に付けます（途中参加の人にも）。オフなら、コードの AttachTo で決めた人だけです。既定 オン"
AttachActiveOnBeginToolTip<public><localizes>:message = "オンなら、ゲームの開始から付けます。オフなら、起動の合図から付けます。既定 オフ"
AttachRefreshSecondsToolTip<public><localizes>:message = "リスポーンなどで体が変わっていないかを見回る間隔（秒）です。変わっていたら付け直します。既定 1"
PlayerMotionCategory<public><localizes>:message = "動きへの反応"
PlayerMotionToolTip<public><localizes>:message = "見張る動きです（ジャンプ・着地・地面から離れた・しゃがみ・スプリント・倒された・ダメージ）。既定 Jumped"
PlayerMotionTargetsToolTip<public><localizes>:message = "動きが起きたときに起動の合図を送る entity です。空なら、この entity とその子孫へ送ります。"
PlayerMotionCooldownToolTip<public><localizes>:message = "同じ人の次の動きを無視する時間（秒）です。0 なら無視しません。既定 0"
PlayerStateToolTip<public><localizes>:message = "見張る状態です（地面・空中・落下・しゃがみ・スプリント・グライダー・水中・飛行・ダウン）。"
PlayerStateTargetsToolTip<public><localizes>:message = "状態に入ったら起動の合図、出たら停止の合図を送る entity です。空なら、この entity の子の entity へ送ります。"
PlayerGroupCategory<public><localizes>:message = "プレイヤーの組"
GroupLeaveOthersToolTip<public><localizes>:message = "オンなら、組に入るとき、同じ親の下のほかの組から出ます（選び直すと前の選びが外れます）。既定 オン"
GroupTargetsToolTip<public><localizes>:message = "組に入った人の起動の合図を送る entity です（ワープ先・ロードアウトなど、選んだときに 1 回すること）。空なら送りません。"
GroupCountGroupToolTip<public><localizes>:message = "人数を数える組（player_group_component を付けた entity）です。空なら、この entity かその祖先の組を数えます。"
GroupCountMinToolTip<public><localizes>:message = "組の人数がこの数以上なら、条件を満たします。既定 1"
GroupCountMaxToolTip<public><localizes>:message = "組の人数がこの数以下なら、条件を満たします。0 にすると「組にだれもいない」。既定 100（上限なし）"
