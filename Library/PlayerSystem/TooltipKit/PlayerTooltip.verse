PlayerCategory<public><localizes>:message = "Player"
MinPlayerCountToolTip<public><localizes>:message = "The condition is satisfied when at least this many players are participating."
AttachCategory<public><localizes>:message = "Attach to player"
AttachPrefabToolTip<public><localizes>:message = "The entity (prefab) attached to the player's body. It moves with the body."
AttachOffsetToolTip<public><localizes>:message = "Offset from the body's origin (centimeters; forward, left, up). Default is 200 straight up"
AttachVisibilityToolTip<public><localizes>:message = "Whom it is shown to. Everyone: all players; OwnerOnly: only the player it is attached to; OthersOnly: everyone except that player. Default Everyone"
AttachEveryoneToolTip<public><localizes>:message = "When on, attaches to everyone on activation (including players who join later). When off, only to players chosen with AttachTo in code. Default on"
AttachActiveOnBeginToolTip<public><localizes>:message = "When on, attaches from the start of the game. When off, attaches from the activation signal. Default off"
AttachRefreshSecondsToolTip<public><localizes>:message = "Interval (seconds) of the check for a changed body (respawn etc.). Reattaches when it changed. Default 1"
PlayerMotionCategory<public><localizes>:message = "Motion reaction"
PlayerMotionToolTip<public><localizes>:message = "The motion to watch (jumped, landed, left the ground, crouch, sprint, eliminated, damaged). Default Jumped"
PlayerMotionTargetsToolTip<public><localizes>:message = "Entities that receive the activation signal when the motion happens. If empty, sent to this entity and its descendants."
PlayerMotionCooldownToolTip<public><localizes>:message = "Time (seconds) during which the same player's next motion is ignored. 0 ignores nothing. Default 0"
PlayerStateToolTip<public><localizes>:message = "The state to watch (on ground, in air, falling, crouching, sprinting, gliding, in water, flying, down)."
PlayerStateTargetsToolTip<public><localizes>:message = "Entities that receive the activation signal on entering the state and the deactivation signal on leaving it. If empty, sent to the child entities of this entity."
PlayerGroupCategory<public><localizes>:message = "Player group"
GroupLeaveOthersToolTip<public><localizes>:message = "When on, joining this group leaves the other groups under the same parent (choosing again cancels the previous choice). Default on"
GroupTargetsToolTip<public><localizes>:message = "Entities that receive the activation signal of a player who joined (warp destination, loadout, etc.; things done once at selection). Nothing is sent if empty."
GroupCountGroupToolTip<public><localizes>:message = "The group whose members are counted (an entity with player_group_component). If empty, the group on this entity or its ancestors is counted."
GroupCountMinToolTip<public><localizes>:message = "The condition is satisfied when the group has at least this many members. Default 1"
GroupCountMaxToolTip<public><localizes>:message = "The condition is satisfied when the group has at most this many members. 0 means \"nobody in the group\". Default 100 (no upper limit)"
