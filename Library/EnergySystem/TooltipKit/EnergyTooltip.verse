EnergyCategory<public><localizes>:message = "Energy"
MaxEnergyToolTip<public><localizes>:message = "The initial maximum energy. If 'Start full' below is on, it starts full."
EnergyStartFullToolTip<public><localizes>:message = "When on, starts full. When off, starts at 0 (when a checkpoint or a restore fills it before use)."
EnergyRestoreAmountToolTip<public><localizes>:message = "The amount of energy restored per use. Restores the most depleted item you hold (or the player's energy if none)."
EnergyRestoreCooldownToolTip<public><localizes>:message = "Seconds after a restore before the next use. 0 means usable at once. Set it to prevent spamming when granted to everyone instead of as an item."
EnergyRestoreConsumeItemToolTip<public><localizes>:message = "When on and this ability is placed on an item, consumes one item per restore (the last one disappears). Unused when not an item."
EnergyRestoreActionToolTip<public><localizes>:message = "The input (Input Action) that restores when pressed. The default is WeaponPrimary (the attack button)."
EnergyRestoreMappingToolTip<public><localizes>:message = "The key mapping (Input Mapping) enabled while granted. Pick one that contains the input above. The default is RangedWeaponMapping (weapon controls)."
EnergyRemoveMappingToolTip<public><localizes>:message = "When on, removes the key mapping above when revoked (for an item, when unequipped). Turn it on only when you picked a mapping dedicated to this ability. With the default RangedWeaponMapping, turning it on also disables the weapon controls."
EnergyAmountCategory<public><localizes>:message = "Amount"
EnergyRestoreCategory<public><localizes>:message = "Restore"
EnergyInputCategory<public><localizes>:message = "Input"
