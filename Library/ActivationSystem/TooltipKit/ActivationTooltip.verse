ActivationCategory<public><localizes>:message = "Activation"
EnableTargetsToolTip<public><localizes>:message = "Entities to enable / disable. When empty, toggles the components attached to this entity (those with an enabled state: meshes, lights, interactables, etc.)."
EnableInvertToolTip<public><localizes>:message = "When on, reverses it (disable on the activation signal, enable on the deactivation signal). Default off"
EnableApplyOnBeginToolTip<public><localizes>:message = "When on, applies the 'deactivated' state at the start of the game (start of the simulation) (e.g. keep hidden until activated). Default on"
RoundTargetsToolTip<public><localizes>:message = "Entities that receive the round start and end signals. When empty, sends to this entity and its descendants."
RoundFirstToolTip<public><localizes>:message = "Sends signals from this round number (from 1; 0 means from the first). Default 0"
RoundLastToolTip<public><localizes>:message = "Sends signals up to this round number (0 means to the last). Default 0"
