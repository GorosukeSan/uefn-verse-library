VolumeCategory<public><localizes>:message = "Volume"
VolumeShapeToolTip<public><localizes>:message = "Shape of the volume. Box is a width x depth x height box, Cylinder is an upright cylinder whose diameter is the width. Default Box"
VolumeWidthToolTip<public><localizes>:message = "Width of the volume (forward/back, cm). Multiplied by the entity's Scale. The diameter for a cylinder. Default 100"
VolumeDepthToolTip<public><localizes>:message = "Depth of the volume (left/right, cm). Multiplied by the entity's Scale. Unused for a cylinder. Default 100"
VolumeHeightToolTip<public><localizes>:message = "Height of the volume (cm). The bottom face is at the entity's position. Multiplied by the entity's Scale. Default 100"
VolumeHeightMarginToolTip<public><localizes>:message = "Extra margin added above and below the volume (cm). A character's position is the middle of its body, so use about 300 for a thin floor-like volume. Default 100"
VolumePollIntervalToolTip<public><localizes>:message = "Interval between checks for entries and exits (seconds). Shorter notices sooner but costs more. Default 0.25"
VolumeActiveOnBeginToolTip<public><localizes>:message = "When on, checks from the start of the game (start of the simulation). When off, checks from the activation signal (in a game sequence, when this node is entered). Default on"
VolumeMinPlayersToolTip<public><localizes>:message = "Satisfied when at least this many players are inside. Default 1"
VolumeConditionVolumeToolTip<public><localizes>:message = "The volume to watch (an entity with player_volume_component). When empty, counts the notifications from volumes on this entity or its descendants."
VolumeActivationTargetsToolTip<public><localizes>:message = "Entities that receive the activation signal when the first player enters and the deactivation signal when the last one leaves (the entity and its descendants receive it). When empty, sends to this entity's child entities (except the volume's entity)."
