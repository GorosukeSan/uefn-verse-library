VolumeCategory<public><localizes>:message = "ボリューム"
VolumeShapeToolTip<public><localizes>:message = "範囲の形です。Box は幅 × 奥行き × 高さの箱、Cylinder は直径が幅の縦の円柱です。既定 Box"
VolumeWidthToolTip<public><localizes>:message = "範囲の幅（前後、cm）。entity の大きさ（Scale）を掛けます。円柱では直径。既定 100"
VolumeDepthToolTip<public><localizes>:message = "範囲の奥行き（左右、cm）。entity の大きさ（Scale）を掛けます。円柱では使いません。既定 100"
VolumeHeightToolTip<public><localizes>:message = "範囲の高さ（cm）。底面が entity の位置です。entity の大きさ（Scale）を掛けます。既定 100"
VolumeHeightMarginToolTip<public><localizes>:message = "範囲の上下に足す余裕（cm）。キャラクターの位置は体の真ん中なので、薄い床のような範囲では 300 くらいにします。既定 100"
VolumePollIntervalToolTip<public><localizes>:message = "出入りを調べる間隔（秒）。短いほど早く気付きますが、そのぶん重くなります。既定 0.25"
VolumeActiveOnBeginToolTip<public><localizes>:message = "オンなら、ゲームの開始（シミュレーションの開始）から調べます。オフなら、起動の合図（ゲームの流れなら、このノードに入ったとき）から調べます。既定 オン"
VolumeMinPlayersToolTip<public><localizes>:message = "この人数以上が中にいれば満たします。既定 1"
VolumeConditionVolumeToolTip<public><localizes>:message = "見張るボリューム（player_volume_component を付けた entity）。空なら、この entity か子孫のボリュームの知らせを数えます。"
VolumeActivationTargetsToolTip<public><localizes>:message = "最初の 1 人が入ったら起動の合図、最後の 1 人が出たら停止の合図を送る entity（その entity と子孫に届きます）。空なら、この entity の子の entity に送ります（ボリュームの entity は除く）。"
