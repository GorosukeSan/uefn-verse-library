McpCategory<public><localizes>:message = "MCP"
McpNameToolTip<public><localizes>:message = "Name used to address this entity from MCP (Python outside the editor). Verse cannot read entity names, so attach this to any entity you want to find by name. The same name may be used more than once (a search returns them all)."
McpInboxTextToolTip<public><localizes>:message = "Command JSON written by MCP. Leave it empty in the editor. When MCP rewrites it during a session, live edit delivers it to the game; the inbox runs the commands and prints the replies to the log."
McpInboxRunAtStartToolTip<public><localizes>:message = "When on, the commands already in the inbox are executed when the inbox starts (round start, reset, Verse reload). Use it to start from commands written before the session (such as restoring a state). When off, the contents at start are ignored and only changes are executed."
McpInboxMaxPerFrameToolTip<public><localizes>:message = "Maximum number of commands executed per frame. Lower it when sending many heavy commands (such as spawning prefabs)."
McpInboxMaxLineCharsToolTip<public><localizes>:message = "Maximum characters per reply line. The replies of one frame are joined into one line; the overflow goes out in the next frame. MCP truncates a log line at 16384 characters, so keep it below that."
McpInboxQuietToolTip<public><localizes>:message = "When on, replies and notifications are not printed to the log (commands still run). Use it to keep the log clean on a published island."
McpInboxLogLevelToolTip<public><localizes>:message = "Initial verbosity of the inbox log. 0 prints replies only, 1 start-up and broken commands, 2 every command, 3 even more detail. It can be changed during the session with debug.set_level."
McpToolsetIdToolTip<public><localizes>:message = "Name used when several parts of the same toolset are placed. When empty, the toolset name alone reaches it. With a name, toolset@name also reaches only this part."
McpWidgetScreenIdToolTip<public><localizes>:message = "Name used to address the screen from MCP (the screen of widget.screens and widget.press). Only the screens on entities that carry this component are visible and pressable from MCP (opt-in per screen)."
McpWidgetAllowPressToolTip<public><localizes>:message = "When on, MCP can press the buttons of this screen (the press reaches AwaitClick / AwaitChoice like a real click). When off, the screen is only listed."
McpWidgetAllowShowHideToolTip<public><localizes>:message = "When on, MCP can show and close this screen (widget.show / widget.close)."
McpSessionRestoreOnRoundStartToolTip<public><localizes>:message = "State restored at every round start (the JSON returned by session.snapshot). Empty does nothing. When MCP writes it before starting the session, the game starts from a chosen state."
McpSessionMinSeparationToolTip<public><localizes>:message = "When restoring a state, players are kept at least this distance (cm) apart. Closer positions are shifted to the left (no collision check)."
McpRestoreKeyToolTip<public><localizes>:message = "Key used for state snapshot and restore. When empty, the mcp_name_component name is used, or failing that a key built from the placed position."
McpCharacterRecordIntervalToolTip<public><localizes>:message = "Interval (seconds) between samples when recording motion."
McpInboxScreenSecondsToolTip<public><localizes>:message = "Seconds to show reply lines on the client screen as well. 0 writes only to the log (MCP's GetVerseOutput) and never to the screen (Print shows on screen for 2 s by default and gets in the way of play)."
