FNDeviceCategory<public><localizes>:message = "Device"
DeviceTriggersToolTip<public><localizes>:message = "The trigger device fired on the activation signal. If the agent who caused the signal is known, it is fired with that agent."
DeviceStopTriggersToolTip<public><localizes>:message = "The trigger device fired on the deactivation signal."
DeviceEventTriggersToolTip<public><localizes>:message = "The trigger device that sends the activation signal when it fires."
DeviceEventTargetsToolTip<public><localizes>:message = "The entities the activation signal is sent to. When empty, it is sent to this entity and its descendants."
DeviceRecipientsToolTip<public><localizes>:message = "Whom the device is used on. Activator: the agent who caused the signal; Owner: the owner (the agent who caused the signal when there is none); Everyone: everyone in the zone."
DeviceEndGameToolTip<public><localizes>:message = "The end game device that ends the game (the win / loss setting is on the device)."
DeviceClassSelectorToolTip<public><localizes>:message = "The class and team selector device to use (which class / team is set on the device)."
DeviceClassChangeToolTip<public><localizes>:message = "What to change (class, team, or both). Default Class"
DeviceScoreManagerToolTip<public><localizes>:message = "The score manager device to use (the points are set on the device)."
DeviceScoreChangeToolTip<public><localizes>:message = "How to change the score. Award adds points as configured on the device; Increment / Decrement move one step up or down. Default Award"
DeviceSequencesToolTip<public><localizes>:message = "The cinematic sequence device to play."
DevicePlayScopeToolTip<public><localizes>:message = "Whom to play for. Everyone: everyone; Activator: only the agent who caused the signal (set the device's Visibility to Instigator). Default Everyone"
DeviceStopOnDeactivateToolTip<public><localizes>:message = "When on, stops on the deactivation signal. Default on"
DeviceAudioPlayersToolTip<public><localizes>:message = "The audio player device to play."
