FNDeviceCategory<public><localizes>:message = "デバイス"
DeviceTriggersToolTip<public><localizes>:message = "起動の合図で鳴らすトリガー デバイスです。合図を起こした人が分かれば、その人で鳴らします。"
DeviceStopTriggersToolTip<public><localizes>:message = "停止の合図で鳴らすトリガー デバイスです。"
DeviceEventTriggersToolTip<public><localizes>:message = "鳴ったら起動の合図を送るトリガー デバイスです。"
DeviceEventTargetsToolTip<public><localizes>:message = "起動の合図を送る entity です。空なら、この entity とその子孫へ送ります。"
DeviceRecipientsToolTip<public><localizes>:message = "だれに対してデバイスを使うかです。Activator は合図を起こした人、Owner は持ち主（いなければ合図を起こした人）、Everyone は区画の全員。"
DeviceEndGameToolTip<public><localizes>:message = "終わらせるゲーム終了デバイスです（勝ち負けの設定はデバイス側）。"
DeviceClassSelectorToolTip<public><localizes>:message = "使う職業とチームの選択デバイスです（どの職業・チームにするかはデバイス側）。"
DeviceClassChangeToolTip<public><localizes>:message = "何を変えるかです（職業・チーム・両方）。既定 Class"
DeviceScoreManagerToolTip<public><localizes>:message = "使うスコア マネージャー デバイスです（点数はデバイス側）。"
DeviceScoreChangeToolTip<public><localizes>:message = "どう変えるかです。Award はデバイスの設定どおりに加点、Increment / Decrement は 1 段上げ下げ。既定 Award"
DeviceSequencesToolTip<public><localizes>:message = "再生するシネマティック シーケンス デバイスです。"
DevicePlayScopeToolTip<public><localizes>:message = "だれに再生するかです。Everyone は全員、Activator は合図を起こした人だけ（デバイスの Visibility を Instigator にします）。既定 Everyone"
DeviceStopOnDeactivateToolTip<public><localizes>:message = "オンなら、停止の合図で止めます。既定 オン"
DeviceAudioPlayersToolTip<public><localizes>:message = "鳴らすオーディオ プレイヤー デバイスです。"
