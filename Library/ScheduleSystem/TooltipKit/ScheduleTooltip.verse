ScheduleCategory<public><localizes>:message = "Schedule"
ScheduleClockCategory<public><localizes>:message = "Real-time clock"
ScheduleDisplayCategory<public><localizes>:message = "Schedule display"

ClockTimeZoneOffsetToolTip<public><localizes>:message = "Offset between local time and UTC (seconds). Japan Standard Time is 32400 (+9 hours). Used for the start time of daily schedules and for the day boundary (local midnight). Daylight saving time is not considered."
ClockWakeMarginToolTip<public><localizes>:message = "How long after the whole-second boundary to wake (seconds). Too small may wake just before the boundary and drift by 1 second. Leave the default 0.02 unless it causes problems."

ScheduleKindToolTip<public><localizes>:message = "Kind of repetition. Daily = at the same time every day (start time and duration). FixedInterval = at a fixed interval from an anchor time (interval and duration). OneShot = once (start time and duration)."
ScheduleStartHourToolTip<public><localizes>:message = "Hour of the Daily start time (0-23; local time; the time zone is the clock's setting)."
ScheduleStartMinuteToolTip<public><localizes>:message = "Minute of the Daily start time (0-59)."
ScheduleStartSecondToolTip<public><localizes>:message = "Second of the Daily start time (0-59)."
ScheduleDurationToolTip<public><localizes>:message = "Length of the period (seconds). The schedule is Active during this time. Keep it under 86400 for Daily and under the interval for FixedInterval (otherwise it is always Active)."
ScheduleIntervalToolTip<public><localizes>:message = "FixedInterval interval (seconds). Starts every this many seconds from the anchor time. 0 or less means once (same as OneShot)."
ScheduleEpochAnchorToolTip<public><localizes>:message = "Anchor time of FixedInterval, start time of OneShot (epoch seconds = seconds since 1970-01-01 00:00 UTC). Example: 2026-01-01 00:00 UTC = 1767225600."
ScheduleSendActivationToolTip<public><localizes>:message = "When on, sends activated_event to this entity and its descendants when it becomes Active, and deactivated_event when it leaves Active. Countdowns, spawners, screen displays, ability grants (GrantOnBegin off) and so on then follow the schedule with no code."

ScheduleDigitToolTip<public><localizes>:message = "Which digit position to show (1 = ones, 2 = tens, 3 = hundreds)."
ScheduleDigitFieldToolTip<public><localizes>:message = "Which part of the remaining time the digit belongs to. Seconds / Minutes / Hours are the split values 0-59 (hours 0-23), Days is the number of whole days, TotalSeconds / TotalMinutes are unsplit totals."
ScheduleRemainingKindToolTip<public><localizes>:message = "UntilStart = remaining until the next start. UntilEnd = remaining until the end during the period, otherwise until the next start."
ScheduleBlankLeadingZeroToolTip<public><localizes>:message = "When on, no digit is shown when the higher positions are 0 (e.g. the tens of 5 seconds remaining) (all digit meshes are hidden)."
ScheduleGlyphValueToolTip<public><localizes>:message = "The digit (0-9) this mesh represents. Any number of meshes may share the same value."
ScheduleTextFormatToolTip<public><localizes>:message = "Text format. HoursMinutesSeconds = 01:02:03, MinutesSeconds = 62:03, DaysHoursMinutesSeconds = 1d 01:02:03, Days = 1, TotalSeconds = 3723."
ScheduleTextPrefixToolTip<public><localizes>:message = "Fixed string put before the text (e.g. \"Starts in \"). Nothing is added when empty."
ScheduleTextOnlyWhileShownToolTip<public><localizes>:message = "When on, the text is updated every second only while Show() has been called (saves the work for displays nobody is looking at). When off, it is always updated."

ScheduleSequencesToolTip<public><localizes>:message = "Cinematic Sequence devices (with Visibility = Everyone) to play during the period. Play on entering the period, seek to the elapsed time when joining midway, Stop on leaving the period."
ScheduleMaxLateStartToolTip<public><localizes>:message = "Do not play if more than this many seconds have passed since the start when the period is entered (when the server starts midway). 0 means no limit (play from the elapsed time)."
ScheduleResyncOnJoinToolTip<public><localizes>:message = "When on, when a player joins during the period, the sequence is Played and re-seeked to the elapsed time (to align the late joiner's picture. Everyone's playback may skip for a moment. Confirm in UEFN)."

ScheduleHudShowWithinToolTip<public><localizes>:message = "How many seconds before the start to show the countdown on screen (seconds). Outside this window nothing is shown and no per-second work is done."
ScheduleHudTextSizeToolTip<public><localizes>:message = "Text size."
