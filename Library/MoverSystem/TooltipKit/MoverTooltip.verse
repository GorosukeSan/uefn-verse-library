MoverCategory<public><localizes>:message = "動き"
MoverMoveCategory<public><localizes>:message = "動かし方"
MoverPathCategory<public><localizes>:message = "決まった地点"
MoverRandomCategory<public><localizes>:message = "ランダム"
MoverSplineCategory<public><localizes>:message = "曲線の道"
MoverMotionToolTip<public><localizes>:message = "動かし方です。Keyframe はエンジンが滑らかに動かします（ほかの物はすり抜けます。おすすめ）。Physics は毎フレーム Verse で動かし、ほかの物に当たると跳ね返ります。"
MoverSpeedToolTip<public><localizes>:message = "動く速さ（センチメートル毎秒）です。100 で 1 秒に 1 メートル進みます。"
MoverStartOnBeginToolTip<public><localizes>:message = "オンなら、ゲームの始めから動きます。オフなら、起動の合図（activated_event）が届いてから動きます。停止の合図でその場に止まり、次の起動で続きから動きます。"
MoverWaitSecondsToolTip<public><localizes>:message = "行き先に着くたびに、次へ向かう前に止まっている時間（秒）です。"
MoverAlsoSendUpToolTip<public><localizes>:message = "オンなら、行き先を決めた・着いた・道のりが終わった知らせを、子孫に加えて祖先（親から上）へも送ります。ゲームの流れのノードなど、祖先の部品で受けたいときに使います。"
MoverBounceSecondsToolTip<public><localizes>:message = "Physics のとき、ほかの物に当たって跳ね返ったあと、跳ね返った向きに進む時間（秒）です。そのあとは同じ行き先へ戻ります。0 なら、その行き先をあきらめて次の行き先へ向かいます。"
MoverPathModeToolTip<public><localizes>:message = "地点の回り方です。Loop は最後のあと最初へ戻って回り続け、PingPong は行き来を続け、Once は最後の地点で止まります。"
MoverPathIncludeStartToolTip<public><localizes>:message = "オンなら、置いた位置（動き出す位置）を最初の地点にします。オフなら、目印の地点だけを回ります（最初は 1 番目の目印へ向かいます）。"
MoverWaypointOrderToolTip<public><localizes>:message = "回る順番です。小さい順に回ります（子の並び順は関係ありません）。同じ数どうしの順は決まりません。"
MoverRandomRadiusToolTip<public><localizes>:message = "動き出した位置から何センチメートル以内で、行き先を選ぶかです。"
MoverRandomMinStepToolTip<public><localizes>:message = "次の行き先を、今の位置から少なくとも何センチメートル先にするかです（近すぎる行き先で小刻みに動かないようにします）。"
MoverRandomMaxDescentToolTip<public><localizes>:message = "行き先を、動き出した位置から何センチメートル下までにするかです。これより下の行き先は、この高さまで持ち上げます。0 なら動き出した高さより下には行きません。"
MoverSplineClosedToolTip<public><localizes>:message = "オンなら、最後の地点から最初の地点へも曲線でつなぎ、輪を回り続けます（動き方 Mode は使いません）。地点は 3 つ以上にします（2 つなら直線の行き来になります）。"
MoverSplineModeToolTip<public><localizes>:message = "閉じていない（Closed がオフの）ときの回り方です。PingPong は同じ曲線を行き来し、Once は最後の地点で止まり、Loop は最後の地点から最初の地点へまっすぐ戻ります。"
MoverSplineSubdivisionsToolTip<public><localizes>:message = "地点のあいだの曲線を、いくつの直線に分けて進むかです。多いほど滑らかになります。地点が 2 つのときは直線（1）です。"
MoverSplineFaceToolTip<public><localizes>:message = "オンなら、進む向きに足場の向き（前 = Forward 軸のヨー）を合わせます。傾きは変えません。"
