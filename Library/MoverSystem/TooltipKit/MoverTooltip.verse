MoverCategory<public><localizes>:message = "Mover"
MoverMoveCategory<public><localizes>:message = "Motion"
MoverPathCategory<public><localizes>:message = "Fixed points"
MoverRandomCategory<public><localizes>:message = "Random"
MoverSplineCategory<public><localizes>:message = "Curved path"
MoverMotionToolTip<public><localizes>:message = "How to move. Keyframe lets the engine move it smoothly (it passes through other objects; recommended). Physics moves it in Verse every frame and bounces when it hits another object."
MoverSpeedToolTip<public><localizes>:message = "Speed (centimeters per second). 100 moves 1 meter per second."
MoverStartOnBeginToolTip<public><localizes>:message = "When on, moves from the start of the game. When off, starts moving when the activate signal (activated_event) arrives. The deactivate signal stops it in place, and the next activation continues from there."
MoverWaitSecondsToolTip<public><localizes>:message = "Seconds to stay at each target before heading to the next."
MoverAlsoSendUpToolTip<public><localizes>:message = "When on, the target chosen / reached / route finished notifications are also sent to the ancestors (from the parent upward), in addition to the descendants. Use it when an ancestor part, such as a game flow node, should receive them."
MoverBounceSecondsToolTip<public><localizes>:message = "With Physics, seconds to travel in the bounced direction after hitting another object. Then it heads back to the same target. 0 gives up that target and heads for the next one."
MoverPathModeToolTip<public><localizes>:message = "How the points are traversed. Loop returns to the first point after the last and keeps going, PingPong keeps going back and forth, and Once stops at the last point."
MoverPathIncludeStartToolTip<public><localizes>:message = "When on, the placed position (where it starts moving) becomes the first point. When off, only the marker points are visited (it heads for the first marker first)."
MoverWaypointOrderToolTip<public><localizes>:message = "Traversal order. Visited in ascending order (the order of the children does not matter). The order among equal numbers is unspecified."
MoverRandomRadiusToolTip<public><localizes>:message = "Within how many centimeters of the start position the targets are chosen."
MoverRandomMinStepToolTip<public><localizes>:message = "How many centimeters away from the current position, at least, the next target must be (avoids jittering between targets that are too close)."
MoverRandomMaxDescentToolTip<public><localizes>:message = "How many centimeters below the start position a target may be. Targets lower than this are lifted up to this height. 0 never goes below the start height."
MoverSplineClosedToolTip<public><localizes>:message = "When on, the last point is also joined to the first point with a curve, and it keeps going around the loop (Mode is not used). Use 3 or more points (2 points give a straight back-and-forth)."
MoverSplineModeToolTip<public><localizes>:message = "Traversal when not closed (Closed is off). PingPong goes back and forth along the same curve, Once stops at the last point, and Loop returns straight from the last point to the first."
MoverSplineSubdivisionsToolTip<public><localizes>:message = "How many straight segments each curve between points is divided into. More is smoother. With 2 points it is a straight line (1)."
MoverSplineFaceToolTip<public><localizes>:message = "When on, the platform's facing (yaw of the front = Forward axis) is aligned to the direction of travel. Tilt is unchanged."
