PlayerWidgetCategory<public><localizes>:message = "Screen Display"
PlayerWidgetModeToolTip<public><localizes>:message = "Hud is a display that does not take input (movement and camera controls keep working while shown). Menu is a screen that takes input and moves focus the moment it is shown."
PlayerWidgetAudienceToolTip<public><localizes>:message = "Whose screen to show on. Everyone shows to all when activated (late joiners too); Chosen shows only to people chosen with ShowFor (decided by a widget_show_ component on the same entity). Default Everyone"
PlayerWidgetZOrderToolTip<public><localizes>:message = "Stacking order on the screen. Larger is in front (guide: HUD 0-100, menus 1000, notifications 10000). Default 0"
PlayerWidgetMenuConflictToolTip<public><localizes>:message = "When another menu is already shown to the same person: close the previous menu and show this one (CloseOther), or keep the previous one and do not show this one (KeepOther). Used only when Mode is Menu. Default CloseOther"
PlayerWidgetActiveOnBeginToolTip<public><localizes>:message = "When on, shows from the start of the game. When off, shows from the activation signal (for a game sequence, when this node is entered). Default off"
PlayerWidgetForwardToolTip<public><localizes>:message = "When on, notifications that reach this entity are passed to the displays of everyone it is shown to (to receive display-changing notifications from parts on the same entity). Default off"
WidgetPositionXToolTip<public><localizes>:message = "Position (horizontal screen ratio; left edge 0.0, right edge 1.0). Placed centered on that point."
WidgetPositionYToolTip<public><localizes>:message = "Position (vertical screen ratio; top edge 0.0, bottom edge 1.0). Placed centered on that point."
ChoiceMenuCategory<public><localizes>:message = "Choice Menu"
ChoiceMenuTitleToolTip<public><localizes>:message = "Heading shown above the menu. Not shown if empty."
ChoiceMenuOptionsToolTip<public><localizes>:message = "Options to line up (index 0, 1, 2 ... from the top). When pressed, sends the chosen notification upward and an activation signal to the Targets entry with the same index."
ChoiceMenuTargetsToolTip<public><localizes>:message = "Entity that receives an activation signal per option (same order as Options). Missing indices send nothing."
ChoiceMenuCloseOnChoiceToolTip<public><localizes>:message = "When on, closes that person's menu after choosing. Default on"
ChoiceMenuShowCloseToolTip<public><localizes>:message = "When on, adds a button at the end that closes without choosing. Default on"
ChoiceMenuCloseTextToolTip<public><localizes>:message = "Text of the close button."
TextHudCategory<public><localizes>:message = "Text HUD"
TextHudTextToolTip<public><localizes>:message = "Text shown at first. Can be changed later with SetText / SetTextFor or hud_text_request_event."
GaugeHudCategory<public><localizes>:message = "Gauge HUD"
GaugeWidthToolTip<public><localizes>:message = "Bar width (screen pixels). Default 300"
GaugeHeightToolTip<public><localizes>:message = "Bar height (screen pixels). Default 16"
GaugeFillColorToolTip<public><localizes>:message = "Color of the bar fill."
GaugeBackColorToolTip<public><localizes>:message = "Color of the bar background."
GaugeInitialRatioToolTip<public><localizes>:message = "Initial ratio (0.0-1.0). Default 1.0"
NotificationHudCategory<public><localizes>:message = "Notification HUD"
NotificationSecondsToolTip<public><localizes>:message = "How long one notification stays (seconds). Default 3"
NotificationMaxLinesToolTip<public><localizes>:message = "Maximum number of notifications shown at once. Beyond it, the oldest are removed. Default 4"
HudHideCategory<public><localizes>:message = "Hide Standard HUD"
HudHideActiveOnBeginToolTip<public><localizes>:message = "When on, hides from the start of the game. When off, hides from the activation signal. Default off"
HudHideElementToolTip<public><localizes>:message = "When on, hides this standard HUD element (hidden per person and restored when deactivated)."
ShowInGroupToolTip<public><localizes>:message = "The group (an entity with player_group_component). The widgets on the same entity are shown only to people in that group. Empty uses the group of this entity or an ancestor."
CardInfoCategory<public><localizes>:message = "Card Info"
CardTitleToolTip<public><localizes>:message = "Name of the card (large text). If empty, a fallback name decided by the screen (the ID, etc.) is shown. This component is the only owner of the name."
CardSubtitleToolTip<public><localizes>:message = "One line under the name. Not shown if empty. Per-person text (records, etc.) is swapped in on the screen side."
CardDescriptionToolTip<public><localizes>:message = "Description (shown wrapped). Not shown if empty."
CardBadgeToolTip<public><localizes>:message = "Small badge at the top right (difficulty, new, etc.). Not shown if empty."
CardThumbnailToolTip<public><localizes>:message = "Image shown at the top. If empty, a band of the card color (AccentColor) is shown."
CardAccentColorToolTip<public><localizes>:message = "Card color (the band when there is no image, and the badge background)."
CardOrderToolTip<public><localizes>:message = "Sort order (smaller comes first). The order among equal values is undefined, so give each card a different value. Default 0"
CardMenuCategory<public><localizes>:message = "Card Menu"
CardMenuTitleToolTip<public><localizes>:message = "Heading shown above the cards. Not shown if empty."
CardMenuColumnsToolTip<public><localizes>:message = "Number of cards per row. More cards wrap to the next row. Default 4"
TextHudColorToolTip<public><localizes>:message = "Text color. Default white"
TextHudSizeToolTip<public><localizes>:message = "Text size (pixels at 1080p). 0 uses Fortnite's default size. Default 0"
TextHudBackgroundOpacityToolTip<public><localizes>:message = "Opacity of the panel behind the text (0.0-1.0). 0 shows no panel. Default 0"
TextHudBackgroundColorToolTip<public><localizes>:message = "Color of the panel behind the text. Default black"
CardMenuPointerFovToolTip<public><localizes>:message = "Horizontal camera field of view (degrees) used when pressing a card in with the Virtual Pointer. Converts the pressed position to a screen ratio. Default 90"
HudHideAllToolTip<public><localizes>:message = "When on, hides the whole standard Fortnite HUD (health, inventory, materials, minimap, rounds, prompts, etc.). The individual settings below are ignored. Default off"
CardIdToolTip<public><localizes>:message = "Button ID used when pressing from code or tests (MCP). Empty uses the name (Title). Set it when you want the ID to stay the same even if the name changes."
