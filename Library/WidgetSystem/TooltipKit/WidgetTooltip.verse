PlayerWidgetCategory<public><localizes>:message = "画面表示"
PlayerWidgetModeToolTip<public><localizes>:message = "Hud は操作を奪わない表示です（表示中も移動やカメラの操作はそのまま）。Menu は操作を受け取る画面で、表示した瞬間にフォーカスを移します。"
PlayerWidgetAudienceToolTip<public><localizes>:message = "だれの画面に出すかです。Everyone は起動したら全員（途中参加の人にも）、Chosen は ShowFor で決めた人だけ（同じ entity の widget_show_ の component が決めます）。既定 Everyone"
PlayerWidgetZOrderToolTip<public><localizes>:message = "画面に重ねる順です。大きいほど手前に出ます（目安：HUD 0〜100、メニュー 1000、通知 10000）。既定 0"
PlayerWidgetMenuConflictToolTip<public><localizes>:message = "同じ人にもう別のメニューが出ているとき、前のメニューを閉じてこちらを出す（CloseOther）か、前を残してこちらを出さない（KeepOther）かです。Mode が Menu のときだけ使います。既定 CloseOther"
PlayerWidgetActiveOnBeginToolTip<public><localizes>:message = "オンなら、ゲームの開始から出します。オフなら、起動の合図（ゲームの流れなら、このノードに入ったとき）から出します。既定 オフ"
PlayerWidgetForwardToolTip<public><localizes>:message = "オンなら、この entity に届いた知らせを、出している全員の表示へ渡します（表示を変える知らせを、同じ entity の部品から受けるとき）。既定 オフ"
WidgetPositionXToolTip<public><localizes>:message = "置く位置です（画面の横の割合。左端 0.0、右端 1.0）。その点を真ん中にして置きます。"
WidgetPositionYToolTip<public><localizes>:message = "置く位置です（画面の縦の割合。上端 0.0、下端 1.0）。その点を真ん中にして置きます。"
ChoiceMenuCategory<public><localizes>:message = "選択メニュー"
ChoiceMenuTitleToolTip<public><localizes>:message = "メニューの上に出す見出しです。空なら出しません。"
ChoiceMenuOptionsToolTip<public><localizes>:message = "並べる項目です（上から番号 0, 1, 2 ...）。押されると、選んだ知らせを上へ送り、同じ番号の Targets に起動の合図を送ります。"
ChoiceMenuTargetsToolTip<public><localizes>:message = "項目ごとに起動の合図を送る entity です（Options と同じ並び）。足りない番号は送りません。"
ChoiceMenuCloseOnChoiceToolTip<public><localizes>:message = "オンなら、選んだらその人のメニューを閉じます。既定 オン"
ChoiceMenuShowCloseToolTip<public><localizes>:message = "オンなら、最後に何も選ばずに閉じるボタンを足します。既定 オン"
ChoiceMenuCloseTextToolTip<public><localizes>:message = "閉じるボタンの文字です。"
TextHudCategory<public><localizes>:message = "文字の HUD"
TextHudTextToolTip<public><localizes>:message = "最初に出す文字です。あとから SetText / SetTextFor や hud_text_request_event で変えられます。"
GaugeHudCategory<public><localizes>:message = "ゲージの HUD"
GaugeWidthToolTip<public><localizes>:message = "棒の幅（画面のピクセル）です。既定 300"
GaugeHeightToolTip<public><localizes>:message = "棒の高さ（画面のピクセル）です。既定 16"
GaugeFillColorToolTip<public><localizes>:message = "棒の中身の色です。"
GaugeBackColorToolTip<public><localizes>:message = "棒の背景の色です。"
GaugeInitialRatioToolTip<public><localizes>:message = "最初の割合（0.0〜1.0）です。既定 1.0"
NotificationHudCategory<public><localizes>:message = "通知の HUD"
NotificationSecondsToolTip<public><localizes>:message = "1 つの通知を出しておく時間（秒）です。既定 3"
NotificationMaxLinesToolTip<public><localizes>:message = "同時に出す通知の数の上限です。超えたら古いものから消します。既定 4"
HudHideCategory<public><localizes>:message = "標準 HUD を隠す"
HudHideActiveOnBeginToolTip<public><localizes>:message = "オンなら、ゲームの開始から隠します。オフなら、起動の合図から隠します。既定 オフ"
HudHideElementToolTip<public><localizes>:message = "オンなら、この標準 HUD を隠します（人ごとに隠し、止まると元に戻します）。"
ShowInGroupToolTip<public><localizes>:message = "組（player_group_component を付けた entity）です。その組に入っている人にだけ、同じ entity の widget を出します。空なら、この entity かその祖先の組を使います。"
CardInfoCategory<public><localizes>:message = "カードの情報"
CardTitleToolTip<public><localizes>:message = "カードの名前です（大きい文字）。空なら、画面が決める代わりの名前（ID など）を出します。名前の持ち主はこの component だけにします。"
CardSubtitleToolTip<public><localizes>:message = "名前の下の 1 行です。空なら出しません。人ごとに変わる文字（記録など）は、画面の側で差し替えます。"
CardDescriptionToolTip<public><localizes>:message = "説明です（折り返して出します）。空なら出しません。"
CardBadgeToolTip<public><localizes>:message = "右上の小さい札です（難しさ・新着など）。空なら出しません。"
CardThumbnailToolTip<public><localizes>:message = "上に出す画像です。空なら、カードの色（AccentColor）の帯を出します。"
CardAccentColorToolTip<public><localizes>:message = "カードの色です（画像が無いときの帯と、札の地）。"
CardOrderToolTip<public><localizes>:message = "並び順です（小さいほど先）。同じ値どうしの順は決まらないので、カードごとに変えます。既定 0"
CardMenuCategory<public><localizes>:message = "カードのメニュー"
CardMenuTitleToolTip<public><localizes>:message = "カードの上に出す見出しです。空なら出しません。"
CardMenuColumnsToolTip<public><localizes>:message = "1 行に並べるカードの数です。多いときは次の行へ折り返します。既定 4"
TextHudColorToolTip<public><localizes>:message = "文字の色です。既定 白"
TextHudSizeToolTip<public><localizes>:message = "文字の大きさです（1080p のピクセル）。0 なら Fortnite の既定の大きさです。既定 0"
TextHudBackgroundOpacityToolTip<public><localizes>:message = "文字の後ろに敷く板の不透明度です（0.0〜1.0）。0 なら板を出しません。既定 0"
TextHudBackgroundColorToolTip<public><localizes>:message = "文字の後ろに敷く板の色です。既定 黒"
CardMenuPointerFovToolTip<public><localizes>:message = "Virtual Pointer で押したカードを押し込むときに使う、カメラの水平の画角（度）です。押した位置を画面の割合に直すのに使います。既定 90"
