LoadoutCategory<public><localizes>:message = "Loadout"
LoadoutPrefabToolTip<public><localizes>:message = "Prefab of one player's loadout. Put parts such as abilities, energy, HUD, attachments and a custom character inside it; they affect only that player."
LoadoutEveryoneToolTip<public><localizes>:message = "When on, applied to everyone on activation (late joiners too). When off, only to the players chosen with ApplyTo in code. Default on"
LoadoutActiveOnBeginToolTip<public><localizes>:message = "When on, applied from the start of the game. When off, applied from the activate signal. Default off"
LoadoutGroupToolTip<public><localizes>:message = "Exclusive group. When not empty, other loadouts of the same group are removed from the player before applying (one job per player, etc.)."
