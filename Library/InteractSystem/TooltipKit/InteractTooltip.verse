InteractCategory<public><localizes>:message = "Interact"
InteractTargetsCategory<public><localizes>:message = "Activation targets"
InteractTargetsToolTip<public><localizes>:message = "Entities that receive the activation signal each time a press completes (the entity and its descendants receive it). When empty, only notifies upward that it was pressed."
InteractedTriggerCategory<public><localizes>:message = "Watched button"
InteractedTriggerToolTip<public><localizes>:message = "The entity (one with interact_trigger_component) whose presses are watched. Buttons placed among this entity's descendants count without being picked."
InteractGateOpenOnBeginToolTip<public><localizes>:message = "When on, pressable from the start of the game (start of the simulation). When off, pressable from the activation signal (in a game sequence, when this node is entered)."
InteractToggleToolTip<public><localizes>:message = "When on, alternates the activation and deactivation signals to Targets on each press (switch, lever). When off, sends only the activation signal on each press. Default off"
