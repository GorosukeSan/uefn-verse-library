ItemGrantCategory<public><localizes>:message = "Item Grant"
ItemGrantRandomCountToolTip<public><localizes>:message = "When Pick Mode is Random, how many of the child 'items to grant' are chosen and granted on activation (for the game flow, when this node is entered). Re-picked for each player. If more than the number of children, all are granted."
ItemGrantEntryItemToolTip<public><localizes>:message = "The prefab of the item to grant (for weapons, pick one from Fortnite's Weapons). Left at the default entity, nothing is granted."
ItemGrantEntryCountToolTip<public><localizes>:message = "How many of the same item to grant. Identical items may be merged."
ExclusiveCategory<public><localizes>:message = "One Per Player"
ExclusiveItemTypeToolTip<public><localizes>:message = "The item type (item prefab) limited to one per player. A player who already has an item of this prefab cannot pick up a second one and does not receive one when granted. Usually choose this item's own prefab (left at the default entity, nothing enters while any item is held)."
ItemGrantEntryCategory<public><localizes>:message = "Item To Grant"
ItemGrantPickCategory<public><localizes>:message = "Pick"
ItemHolderCategory<public><localizes>:message = "Item Holder"
ItemHolderRuleToolTip<public><localizes>:message = "Who counts as the holder of this item. Owned: while it is in the inventory (even while another item is equipped); Equipped: while it is equipped. Ability grants and HUDs on the same entity run while a holder is attached."
ItemHolderFriendItemTypeToolTip<public><localizes>:message = "An item (prefab) counted together. While the owner has this item equipped, they also count as the holder of the parent item (only when the parent's Rule is Equipped). Left at the default entity it counts any item, so always choose one."
ItemGrantPickModeToolTip<public><localizes>:message = "What to grant from the child 'items to grant'. All grants everything; Random grants Random Count items, re-picked for each player."
ItemGrantDestinationToolTip<public><localizes>:message = "Where to put the items. Root: the player's inventory (distributed to the place matching the kind); WeaponHotbar: the weapon hotbar (where it can be held). Default Root"
ItemGrantRevokeOnDeactivateToolTip<public><localizes>:message = "When on, takes the granted items back on the deactivation signal (for the game flow, when this node is left). They are added without merging into existing identical items so they can be taken back. Default off"
