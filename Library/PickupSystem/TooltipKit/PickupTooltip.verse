PickupCategory<public><localizes>:message = "Pickup"
PickupEffectCategory<public><localizes>:message = "Pickup Effect"
PickupStageCategory<public><localizes>:message = "Stage Signal"
PickupEffectToolTip<public><localizes>:message = "Prefab of the effect given to the player who picks this up (pickup_effect_component on the root, with the effect parts stacked inside). It is created under the picker's slot, and the picker becomes its owner."
PickupRespawnToolTip<public><localizes>:message = "Seconds until the pickup returns after being picked up. 0 means it does not return (one time only; Restore, the activate signal or a game reset brings it back). Default 10"
PickupVisualToolTip<public><localizes>:message = "Prefab for the look. Created as a child of this entity at start and removed together when picked up. Leaving the default entity adds nothing (only this entity's mesh is used)."
PickupRequireGroupToolTip<public><localizes>:message = "When on, only members of the nearest ancestor player_group_component's group (e.g. players currently playing the map) can pick it up. Default off"
PickupActiveOnBeginToolTip<public><localizes>:message = "When on, it can be picked up from the start. When off, it stays hidden until the activate signal (e.g. an orb revealed by a stage signal). Default on"
PickupDisplayNameToolTip<public><localizes>:message = "Display name (for the output log and your HUD). Not used by the effect itself."
EffectDurationToolTip<public><localizes>:message = "Seconds the effect lasts. 0 means forever (until a game reset, End or the player leaves). Default 10"
EffectInstantToolTip<public><localizes>:message = "When on, the effect ends on the frame after the activate signal is sent (one-shot effects such as shortening the timer). Default off"
EffectIdToolTip<public><localizes>:message = "Name that identifies the same effect. StackMode applies between effects of the same player with the same EffectId. Empty treats every pickup as a separate effect and stacks it."
EffectStackModeToolTip<public><localizes>:message = "What happens when a player who already has the same effect picks it up again. Tier = raise the tier by 1 and reset the remaining time / Extend = add to the remaining time / Refresh = reset the remaining time / Stack = add another copy / Replace = end the old one and start anew / Ignore = do nothing. Default Extend"
EffectMaxStacksToolTip<public><localizes>:message = "When StackMode is Stack, the maximum number of copies at the same time. 0 means no limit. When reached, the copy ending soonest is extended. Default 0"
EffectMaxTierToolTip<public><localizes>:message = "When StackMode is Tier, the maximum tier. Each pickup of the same effect raises it by 1 and it stops here. The parts inside read the tier through the effect's GetTier / TierChangedEvent. Default 3"
StageTargetGroupToolTip<public><localizes>:message = "Name of the signal group. If it matches the Group of an effect's pickup_stage_signal_component, that signal (activate / deactivate) is sent to this entity and its descendants. Empty receives nothing."
StageSignalGroupToolTip<public><localizes>:message = "Group name of the targets (pickup_stage_target_component) to send the signal to. Empty sends nothing."
StageSignalSignalToolTip<public><localizes>:message = "Signal to send. Activate = activate (e.g. reveal hidden platforms) / Deactivate = deactivate (e.g. stop a hazard). Default Activate"
StageSignalScopeToolTip<public><localizes>:message = "Where to look for targets. SourceRoot = inside the top-level entity (the map) of the picked-up object / SourceScope = inside the picked-up object's scope (the world if none) / World = the world. Default SourceRoot"
StageSignalRevertToolTip<public><localizes>:message = "When on, reverts when the effect ends (when the deactivate signal is received). When off, leaves the signal as sent. Default on"
PickupHudCategory<public><localizes>:message = "Pickup Effect HUD"
PickupHudShowToastsToolTip<public><localizes>:message = "When on, picking up an effect (including picking the same effect up again) shows two lines of text above the slots (line 1: \"Got <name>!\" (the name in AccentColor; the format is the style's ToastFormat), line 2: the description). The look comes from the card_info_component on the root of the effect prefab: Title, Description, AccentColor. Default on"
PickupHudShowListToolTip<public><localizes>:message = "When on, ongoing effects are lined up as square slots at the bottom center of the screen (border in AccentColor, image from Thumbnail (or a colored square with the first letter of the name), and a translucent black background whose height shrinks downward with the remaining time). Effects with the same EffectId are merged into one slot marked \"x2\". Instant effects and short effects (DurationSeconds below the style's MinSlotSeconds) are not listed. Default on"
