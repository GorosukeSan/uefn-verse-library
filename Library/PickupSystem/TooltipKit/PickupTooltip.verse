PickupCategory<public><localizes>:message = "拾える物"
PickupEffectCategory<public><localizes>:message = "拾える物の効果"
PickupStageCategory<public><localizes>:message = "ステージへの合図"
PickupEffectToolTip<public><localizes>:message = "拾った人に与える効果のプレハブです（根に pickup_effect_component を置き、中に効果の部品を重ねる）。拾った人の slot の下に作られ、持ち主は拾った人になります。"
PickupRespawnToolTip<public><localizes>:message = "拾われてから戻るまでの秒数です。0 なら戻しません（1 回だけ。Restore・起動の合図・ゲームのやり直しで戻す）。既定 10"
PickupVisualToolTip<public><localizes>:message = "見た目のプレハブです。開始時にこの entity の子に作り、拾われたら一緒に消します。既定の entity のままなら何も足しません（この entity のメッシュだけ）。"
PickupRequireGroupToolTip<public><localizes>:message = "オンなら、祖先の一番近い player_group_component の組にいる人（マップを遊んでいる人など）だけが拾えます。既定 オフ"
PickupActiveOnBeginToolTip<public><localizes>:message = "オンなら開始から拾えます。オフなら起動の合図まで隠しておきます（ステージへの合図で出すオーブなど）。既定 オン"
PickupDisplayNameToolTip<public><localizes>:message = "表示名です（出力ログと、利用者の HUD 用）。効果そのものには使いません。"
EffectDurationToolTip<public><localizes>:message = "効果が続く秒数です。0 ならずっと（ゲームのやり直し・End・退出まで）。既定 10"
EffectInstantToolTip<public><localizes>:message = "オンなら、起動の合図を送った次のフレームで終えます（タイムを縮めるなど 1 回きりの効果）。既定 オフ"
EffectIdToolTip<public><localizes>:message = "同じ効果の見分けの名前です。同じ人の、同じ EffectId の効果どうしに StackMode が効きます。空なら毎回別の効果として重ねます。"
EffectStackModeToolTip<public><localizes>:message = "同じ効果をもう持っている人が拾ったときの扱いです。Extend = 残り時間に足す / Refresh = 残り時間を戻す / Stack = もう 1 つ重ねる / Replace = 前のを終えて新しく / Ignore = 何もしない。既定 Extend"
EffectMaxStacksToolTip<public><localizes>:message = "StackMode が Stack のとき、同時に重ねられる数の上限です。0 なら上限なし。届いていたら一番早く終わるものを延ばします。既定 0"
StageTargetGroupToolTip<public><localizes>:message = "合図のグループの名前です。効果の pickup_stage_signal_component の Group と同じなら、その合図（起動・停止）をこの entity と子孫へ送ります。空なら受けません。"
StageSignalGroupToolTip<public><localizes>:message = "合図を送る相手（pickup_stage_target_component）のグループの名前です。空なら送りません。"
StageSignalSignalToolTip<public><localizes>:message = "送る合図です。Activate = 起動（隠れた足場を出すなど）/ Deactivate = 停止（ハザードを止めるなど）。既定 Activate"
StageSignalScopeToolTip<public><localizes>:message = "相手を探す範囲です。SourceRoot = 拾った物の最上位の entity（マップ）の中 / SourceScope = 拾った物の区画の中（無ければ世界）/ World = 世界。既定 SourceRoot"
StageSignalRevertToolTip<public><localizes>:message = "オンなら、効果が終わったとき（停止の合図を受けたとき）に元に戻します。オフなら送ったままにします。既定 オン"
PickupHudCategory<public><localizes>:message = "拾った効果の HUD"
PickupHudShowToastsToolTip<public><localizes>:message = "オンなら、効果を拾ったとき（同じ効果を拾い直したときも）、画面の上の方に効果の名前と説明を大きく出します（効果のプレハブの根の card_info_component の Title・Description・AccentColor・Thumbnail・Badge）。既定 オン"
PickupHudShowListToolTip<public><localizes>:message = "オンなら、続いている効果を 1 行ずつ並べ、残り時間の棒と秒数を出します（同じ EffectId は 1 行にまとめて重なった数を出す）。Instant の効果と、DurationSeconds が短い効果（見た目の MinRowSeconds 未満）は並べません。既定 オン"
