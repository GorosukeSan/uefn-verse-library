SwingCategory<public><localizes>:message = "Swing"
SwingGrabCategory<public><localizes>:message = "Grab"
SwingRopeCategory<public><localizes>:message = "Rope"
SwingReleaseCategory<public><localizes>:message = "Release"
SwingInputCategory<public><localizes>:message = "Input"
SwingPendulumCategory<public><localizes>:message = "Pendulum"
SwingMaxRangeToolTip<public><localizes>:message = "How far (centimeters) beyond the reticle (screen center) an object can be grabbed (default 4000 = 40 meters). Also the upper limit of the rope length when reeling out."
SwingGrabLiftHeightToolTip<public><localizes>:message = "When grabbing on the ground and jumping, the height (centimeters) the body is lifted by moving its position directly before launching (velocity has no effect while grounded, so the body is lifted first)."
SwingGrabKickSpeedToolTip<public><localizes>:message = "Speed (centimeters per second) added at once at the moment of launch, in the direction of motion (perpendicular to the rope; the look direction when standing still). When grabbing in the air this is added to the current velocity to start the pendulum. Too large and the player shoots off suddenly."
SwingMinRopeLengthToolTip<public><localizes>:message = "The shortest length (centimeters) the rope can be reeled in to."
SwingReelSpeedToolTip<public><localizes>:message = "How fast (centimeters per second) the rope length changes while grabbing, when pressing the use button (fire) again to reel in, or the aim button to reel out."
SwingRopeCorrectionRateToolTip<public><localizes>:message = "When farther away than the rope length, the fraction of the excess pulled back per second (per 100 centimeters of excess, a speed of this value x 100 centimeters per second). Larger makes the rope stiffer, smaller makes it stretch like rubber."
SwingMaxRopeCorrectionSpeedToolTip<public><localizes>:message = "Upper limit of the speed (centimeters per second) at which the excess is pulled back. Smaller gives a smoother pull with no sudden yank (reeling in never exceeds this either)."
SwingReleaseBoostToolTip<public><localizes>:message = "Speed (centimeters per second) added in the direction of motion when the release input (jump) is let go during a swing and the rope detaches. The momentum so far (including hold acceleration) is kept."
SwingReelOutActionToolTip<public><localizes>:message = "Input that reels out (lengthens the rope) while held during a grab. Pressing it while grabbing on the ground before launching releases the rope. Default is WeaponSecondary (the aim button). To reel in, press the grab input (fire) again."
SwingReelOutMappingToolTip<public><localizes>:message = "The input mapping that contains the reel-out input above. Default is RangedWeaponMapping (weapon inputs). It is kept, not removed."
SwingStartSpeedToolTip<public><localizes>:message = "Total speed (centimeters per second) added in the direction of motion (perpendicular to the rope) after launch. It is added gradually over the ease time below, so the swing starts smoothly."
SwingEaseSecondsToolTip<public><localizes>:message = "Time (seconds) after grabbing until the start speed has been fully added. Longer makes the swing start slower and softer."
SwingDragToolTip<public><localizes>:message = "Air drag of the pendulum. This fraction of the speed is lost every second (0.15 means about 15% per second). Larger makes the swing calmer and prevents excessive momentum."
SwingGravityToolTip<public><localizes>:message = "Gravity used by the pendulum calculation (centimeters per second squared; default 980). Larger swings faster: fast at the bottom, slow at the top."
SwingSteerAccelerationToolTip<public><localizes>:message = "How much speed (centimeters per second squared) is added per second toward the look direction (perpendicular to the rope) while grabbing. Lets you widen the swing toward where you look, or change direction."
SwingMaxSpeedToolTip<public><localizes>:message = "Upper limit of the pendulum speed (centimeters per second)."
SwingGroundLaunchMultiplierToolTip<public><localizes>:message = "When grabbing on the ground and jumping, the multiplier applied to the launch momentum (the launch speed above and the pendulum start speed) relative to grabbing in the air."
SwingReleaseActionToolTip<public><localizes>:message = "Input that accelerates while held after grabbing and releases the rope when let go. While waiting on the ground after a grab, pressing it launches. Default is Jump."
SwingReleaseMappingToolTip<public><localizes>:message = "The input mapping that contains the release input above. Default is TraversalMapping (movement inputs). It is kept, not removed."
SwingBoostCategory<public><localizes>:message = "Boost"
SwingHoldAccelerationToolTip<public><localizes>:message = "How much speed (centimeters per second squared) is added per second in the direction of motion while the release input (jump) is held during a swing. Letting go keeps the accelerated momentum."
SwingMaxHoldSpeedToolTip<public><localizes>:message = "Upper limit of the speed (centimeters per second) while accelerating with hold. If smaller than the pendulum speed limit, the pendulum limit is used."
SwingLiftCategory<public><localizes>:message = "Lift"
SwingLiftTravelToolTip<public><localizes>:message = "Direction and distance (centimeters) to move when launched. Forward is front (X), Left is left (-Y), Up is up. Default is straight up 4000 (40 meters). It breaks when the move ends."
SwingLifeCategory<public><localizes>:message = "Lifetime"
SwingLifeSecondsToolTip<public><localizes>:message = "Time (seconds) from the first grab until it breaks. Releasing does not extend it. The final blinking time below is included."
SwingLifeBlinkCountToolTip<public><localizes>:message = "Number of blinks just before it breaks."
SwingLifeBlinkSecondsToolTip<public><localizes>:message = "Blinking time (seconds) just before it breaks. It blinks the number of times above within this time."
SwingLiftSpeedToolTip<public><localizes>:message = "Speed (centimeters per second) after launch. If faster than the swing's max rope correction speed, the holder is left behind and detaches easily."
SwingLandingGraceSecondsToolTip<public><localizes>:message = "Time (seconds) after launch during which touching the ground does not count as landing. Keeps the pendulum from stopping when the feet scrape the ground right after launching from it."
SwingAutoReelSecondsToolTip<public><localizes>:message = "Time (seconds) after the pendulum starts during which the rope reels in automatically, fast at first and slowing down. After that it stops reeling and swings on momentum. 0 disables it."
SwingAutoReelRatioToolTip<public><localizes>:message = "How far the rope reels in automatically, as a ratio of its length when the pendulum started (0.67 means down to two thirds). 1 disables it."
SwingGrabRadiusToolTip<public><localizes>:message = "Thickness of the grab test. A sphere of this radius (centimeters) is swept in the reticle direction and the object it hits is grabbed. Larger lets slightly off-aim grabs succeed. 0 uses a thin line (point) test."
SwingGrabGraceSecondsToolTip<public><localizes>:message = "Time (seconds) during which the last point found can still be grabbed after the reticle leaves the grabbable object. If another object is found meanwhile, it takes over."
SwingGrabBufferSecondsToolTip<public><localizes>:message = "If the use input (fire) is pressed while grabbing and the release follows within this time (seconds), the next object is grabbed right after releasing. Keeps a press meant to coincide with the release from being lost. 0 uses only presses made after releasing."
SwingGrabActionToolTip<public><localizes>:message = "Input that attaches a rope to the object beyond the reticle (screen center) and grabs it. Pressing it again while grabbing reels the rope in. Default is WeaponPrimary (the attack button)."
SwingGrabMappingToolTip<public><localizes>:message = "The input mapping that contains the grab input above. Default is RangedWeaponMapping (weapon inputs). Other features use this mapping too, so it is kept, not removed."
SwingModifierCategory<public><localizes>:message = "Modifier"
SwingModifierRangeToolTip<public><localizes>:message = "Multiplier for the grab range (and the rope length limit when reeling out). 1 leaves it unchanged."
SwingModifierSpeedToolTip<public><localizes>:message = "Multiplier for the pendulum speed limit (and the limit while accelerating with hold). 1 leaves it unchanged."
SwingModifierAccelerationToolTip<public><localizes>:message = "Multiplier for the launch momentum, the steering acceleration toward the look direction and the hold acceleration. 1 leaves it unchanged."
SwingModifierBoostToolTip<public><localizes>:message = "Multiplier for the speed added on release. 1 leaves it unchanged."
SwingModifierReelToolTip<public><localizes>:message = "Multiplier for the reel-in / reel-out speed. 1 leaves it unchanged."
SwingModifierAllowGrabToolTip<public><localizes>:message = "When off, no new grabs are possible (ropes already attached are not released)."
SwingModifierDurationToolTip<public><localizes>:message = "How long (seconds) the modifier stays applied after a request (swing_modifier_request_event). If the same player receives it again, the timer restarts. 0 keeps it applied until deactivated."
SwingMultiCategory<public><localizes>:message = "Multi swing"
SwingPullCategory<public><localizes>:message = "Pull"
SwingMaxRopesToolTip<public><localizes>:message = "Number of ropes that can be attached at the same time. With 2 or more, pressing the grab input during a swing attaches a rope to another point as well (the body swings around roughly the middle of the rope points). 1 keeps the single rope as before."
SwingPullerCorrectionRatioToolTip<public><localizes>:message = "Multiplier for how strongly you are pulled back by the rope while your rope is attached to another player. Smaller pulls the puller more loosely, so they are less thrown around by the other player's movement."
SwingModifierExtraRopesToolTip<public><localizes>:message = "Number added to the ropes that can be attached at the same time (negative subtracts; never below 1)."
SwingReelPullSpeedToolTip<public><localizes>:message = "When you pull the rope from the ground on a player whose rope is attached to you, the speed (centimeters per second) at which that player is pulled straight toward you."
SwingReelPullLengthToolTip<public><localizes>:message = "How far (centimeters) a rope pull drags the other player straight toward you (the rope shortens by that much). Stops once they are as close as possible."
SwingFollowDistanceRatioToolTip<public><localizes>:message = "While waiting on the ground with a rope attached to another player or agent, how far they may move away, as a ratio of the rope limit (grab range), before you follow (launch automatically). 0.25 means a quarter of the limit."
SwingModifierApplyOnBeginToolTip<public><localizes>:message = "When on, applies the modifier to every player from the start of the simulation. When off, applies it from the activate signal (activated_event) to the deactivate signal (deactivated_event)."
