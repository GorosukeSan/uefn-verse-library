InputCategory<public><localizes>:message = "Input"
InputMappingToolTip<public><localizes>:message = "The key mapping (Input Mapping) enabled only while in this node. Removed when the node is left. The default is the menu mapping (E / Q / C / Z / Esc; RB / LB / RT / LT / Back on gamepad)."
InputActionToolTip<public><localizes>:message = "The action (Input Action) whose press is notified. Pressing it tells other features that an input happened. Choose an action contained in the Input Mapping above. The default is NextTab (E key, RB on gamepad)."
ReadyCategory<public><localizes>:message = "Ready"
InputMappingCategory<public><localizes>:message = "Key Mapping"
InputActionCategory<public><localizes>:message = "Notified Action"
InputActiveOnBeginToolTip<public><localizes>:message = "When on, adds the key mapping and notifies presses from the start of the game (the start of the simulation). When off, from the activation signal (for the game flow, when this node is entered) until the deactivation signal."
ReadyActiveOnBeginToolTip<public><localizes>:message = "When on, accepts 'ready' from the start of the game (the start of the simulation). When off, from the activation signal (for the game flow, when this node is entered) until the deactivation signal. The press action is the Input Action of the 'Input' placed on the same entity."
