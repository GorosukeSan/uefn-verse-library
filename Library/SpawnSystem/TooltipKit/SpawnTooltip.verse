SpawnerCategory<public><localizes>:message = "Spawn"
SpawnerCountCategory<public><localizes>:message = "Count"
SpawnerRangeCategory<public><localizes>:message = "Range"
SpawnerPrefabCategory<public><localizes>:message = "What to spawn"
SpawnerCountToolTip<public><localizes>:message = "The number always kept per band (the range between the upper and lower limit around each player; nearby players merge into one). Missing items are added at every \"refill interval\" below. 0 spawns nothing."
SpawnerRefillSecondsToolTip<public><localizes>:message = "Interval (seconds) at which the count is checked and missing items are added."
SpawnerRangeCellsToolTip<public><localizes>:message = "How many cells horizontally from the reference cell (a player etc.), in each of the four directions, the band covers. The reference point is decided by the \"origin\" component on the same entity (this entity's position if there is none)."
SpawnerMinHeightCellsToolTip<public><localizes>:message = "How many cells above the reference cell items are spawned at least (negative also spawns below)."
SpawnerMaxHeightCellsToolTip<public><localizes>:message = "The upper limit of the band. How many cells above the reference cell items are spawned at most."
SpawnerGapCellsToolTip<public><localizes>:message = "How many cells of gap are reserved around the spawn area (an empty space nothing else can enter)."
SpawnerMaxAttemptsToolTip<public><localizes>:message = "Maximum number of times a place is re-picked when no reservable area is found. If none is found, nothing is spawned that round."
SpawnerDespawnBelowCellsToolTip<public><localizes>:message = "The lower limit of the band. Items that fall more than this many cells below the reference cell (and are in no band) are despawned a few at a time (the reserved area is freed when they are gone). 0 despawns nothing."
SpawnerPrefabToolTip<public><localizes>:message = "The prefab to spawn. Left at the default entity, only an empty entity is spawned."
SpawnerFootprintToolTip<public><localizes>:message = "Cells one item uses (forward, left, up). This box is reserved and the item is placed at its center."
SpawnerDespawnPerRefillToolTip<public><localizes>:message = "How many items in no band are despawned per refill at most (they disappear a few at a time, not all at once)."
SpawnerRefillDepthCellsToolTip<public><localizes>:message = "When the band already holds half the count or more, new items are spawned within this many cells of the upper limit (as you climb, items are added above)."
SpawnerMergeGapCellsToolTip<public><localizes>:message = "Per-player bands that come within this many cells of each other are merged into one (the merged band keeps the count of one band)."
OriginZoneCategory<public><localizes>:message = "Safe zone and dead zone for spawning"
OriginSafeHalfCellsToolTip<public><localizes>:message = "Horizontal half width (cells) of the safe zone that moves with the player."
OriginSafeHeightCellsToolTip<public><localizes>:message = "Vertical half height (cells) of the safe zone."
OriginDeadHalfCellsToolTip<public><localizes>:message = "Horizontal half width (cells) of the dead zone (a box that stays where it was placed). Make it wider than the safe zone. Only when the safe zone sticks out of it is it placed again and the spawning recomputed."
OriginDeadHeightCellsToolTip<public><localizes>:message = "Vertical half height (cells) of the dead zone. Make it taller than the safe zone. Spawning is not recomputed while the player moves up and down inside it."
SpawnerFloorCellsToolTip<public><localizes>:message = "The lowest spawn height (cells from grid cell 0). Nothing is spawned below it (set it to the height just reachable from the ground by swinging to keep low places empty)."
SpawnerAppearSecondsToolTip<public><localizes>:message = "Time (seconds) over which the scale changes from 0 to full on spawn (full to 0 on despawn). 0 spawns and despawns instantly."
SpawnerKeepNearCellsToolTip<public><localizes>:message = "Items within this many cells of the player's current position are not despawned even outside the band (keeps visible, reachable items from disappearing; about the swing reach). 0 despawns even nearby items."
OriginDespawnZoneCategory<public><localizes>:message = "Safe zone and dead zone for despawning"
OriginDespawnSafeHalfCellsToolTip<public><localizes>:message = "Horizontal half width (cells) of the safe zone used to decide despawning. Make it wider than the spawning one."
OriginDespawnSafeHeightCellsToolTip<public><localizes>:message = "Vertical half height (cells) of the safe zone used to decide despawning. Make it taller than the spawning one."
OriginDespawnDeadHalfCellsToolTip<public><localizes>:message = "Horizontal half width (cells) of the dead zone used to decide despawning. Only when the safe zone sticks out of it is the despawn range placed again."
OriginDespawnDeadHeightCellsToolTip<public><localizes>:message = "Vertical half height (cells) of the dead zone used to decide despawning."
SpawnerStartOnBeginToolTip<public><localizes>:message = "When on, spawning runs from the start of the game. When off, it runs once the activation signal (activated_event) arrives, and stops and removes everything on the deactivation signal."
SpawnerFitToAreaToolTip<public><localizes>:message = "When on, the item is stretched to fill the reserved area (enter the edge length of the mesh at scale 1 below). When off, the prefab keeps its own size and is placed at the center of the area."
SpawnerMeshSizeToolTip<public><localizes>:message = "Edge length (centimeters) of the mesh at scale 1. 100 for the engine's basic cube. Used when stretching to fill the area."
SpawnerPlaceCategory<public><localizes>:message = "Placement"
SpawnerLevelIntervalToolTip<public><localizes>:message = "If greater than 0, heights are fixed to levels every this many cells and only one item is spawned per level (a level that was used once is not respawned even after it disappears). 0 makes the height random too. Default 0"
SpawnPrefabCategory<public><localizes>:message = "Spawn prefab"
SpawnPrefabToolTip<public><localizes>:message = "The prefab to spawn. Spawned items become children of this entity. Left at the default entity, only an empty entity is spawned."
SpawnPrefabOnActivateToolTip<public><localizes>:message = "Number spawned each time the activation signal arrives (in a game flow, when this node is entered). 0 spawns nothing on the signal (spawn from code)."
SpawnPrefabMaxCountToolTip<public><localizes>:message = "Maximum number that can exist at once. Once reached, nothing more is spawned. 0 means no limit."
SpawnPrefabPointOrderToolTip<public><localizes>:message = "The order in which the child \"spawn points\" (spawn_point_component) are used. InOrder uses them one by one by ascending \"Order\"; Random picks one at random each time. Without spawn points, items are spawned at this entity's position."
SpawnPrefabScatterToolTip<public><localizes>:message = "Items are offset at random inside a box of +/- this length (centimeters) forward, left and up from the spawn point. An axis set to 0 is not offset."
SpawnPrefabDespawnOnDeactivateToolTip<public><localizes>:message = "When on, every spawned item is removed on the deactivation signal (in a game flow, when this node is left). When off, the deactivation signal removes nothing."
SpawnPointOrderToolTip<public><localizes>:message = "The order used when the parent \"spawn prefab\" uses InOrder. Points with smaller numbers are used first."
