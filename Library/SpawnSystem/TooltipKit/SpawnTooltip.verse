SpawnerCategory<public><localizes>:message = "出す"
SpawnerCountCategory<public><localizes>:message = "数"
SpawnerRangeCategory<public><localizes>:message = "範囲"
SpawnerPrefabCategory<public><localizes>:message = "出すもの"
SpawnerCountToolTip<public><localizes>:message = "帯（プレイヤーごとの上限と下限の範囲。近い人どうしは 1 つにまとまる）ごとに、いつも保つ数です。足りない分は、下の「補充の間隔」ごとに足します。0 なら何も出しません。"
SpawnerRefillSecondsToolTip<public><localizes>:message = "数が足りているかを確かめて足す間隔（秒）です。"
SpawnerRangeCellsToolTip<public><localizes>:message = "基準の点（プレイヤーなど）のマスから水平に、前後左右それぞれ何マスまでを帯にするかです。基準の点は、同じ entity に置いた「基準」の component が決めます（無ければこの entity の位置）。"
SpawnerMinHeightCellsToolTip<public><localizes>:message = "基準のマスから、少なくとも何マス上に出すかです（マイナスなら下にも出します）。"
SpawnerMaxHeightCellsToolTip<public><localizes>:message = "帯の上限です。基準のマスから何マス上まで出すかです。"
SpawnerGapCellsToolTip<public><localizes>:message = "出す範囲のまわりに、何マスの空きを借りておくかです（ほかのものが入れない空きの場所になります）。"
SpawnerMaxAttemptsToolTip<public><localizes>:message = "借りられる範囲が見つからないとき、場所を選び直す回数の上限です。見つからなければ、その回は出しません。"
SpawnerDespawnBelowCellsToolTip<public><localizes>:message = "帯の下限です。基準のマスより、このマス数より下に外れたもの（どの帯にも入らないもの）を、少しずつ消します（消えると借りた範囲が空きます）。0 なら消しません。"
SpawnerPrefabToolTip<public><localizes>:message = "出す prefab を選びます。既定の entity のままだと、何も無い entity を出すだけです。"
SpawnerFootprintToolTip<public><localizes>:message = "1 つ分が使う範囲のマス数（前・左・上）です。この直方体を借り、その真ん中に置きます。"
SpawnerDespawnPerRefillToolTip<public><localizes>:message = "どの帯にも入らないものを、1 回の補充で何個まで消すかです（一度に消えず、少しずつ消えます）。"
SpawnerRefillDepthCellsToolTip<public><localizes>:message = "帯の中にもう半分以上あるとき、新しく出すのを上限から何マスのあいだにするかです（上へ進むと、上に足されていきます）。"
SpawnerMergeGapCellsToolTip<public><localizes>:message = "プレイヤーごとの帯が、このマス数以内まで近づいたら 1 つにまとめます（まとめた帯の数は 1 つ分）。"
OriginZoneCategory<public><localizes>:message = "生成用のセーフゾーンとデッドゾーン"
OriginSafeHalfCellsToolTip<public><localizes>:message = "プレイヤーについて動くセーフゾーンの、水平の半分の幅（マス）です。"
OriginSafeHeightCellsToolTip<public><localizes>:message = "セーフゾーンの、上下の半分の高さ（マス）です。"
OriginDeadHalfCellsToolTip<public><localizes>:message = "デッドゾーン（置いたら動かない箱）の、水平の半分の幅（マス）です。セーフゾーンより広くします。セーフゾーンがこの外へはみ出したときだけ、置き直して出し入れを計算し直します。"
OriginDeadHeightCellsToolTip<public><localizes>:message = "デッドゾーンの、上下の半分の高さ（マス）です。セーフゾーンより広くします。この中で上下しているあいだは、出し入れを計算し直しません。"
SpawnerFloorCellsToolTip<public><localizes>:message = "出す高さの最低（グリッドの 0 番からのマス）です。これより下には出しません（スイングで地面からぎりぎり届く高さにすると、低い所に出なくなります）。"
SpawnerAppearSecondsToolTip<public><localizes>:message = "出すとき・消すときに、大きさを 0 から元へ（元から 0 へ）変える時間（秒）です。0 ならすぐに出し入れします。"
SpawnerKeepNearCellsToolTip<public><localizes>:message = "プレイヤーの今の位置から、このマス数以内にあるものは、帯の外になっても消しません（見えていて届くものが消えないようにします。スイングの届く距離くらいにします）。0 なら近くでも消します。"
OriginDespawnZoneCategory<public><localizes>:message = "消去用のセーフゾーンとデッドゾーン"
OriginDespawnSafeHalfCellsToolTip<public><localizes>:message = "消すかどうかを決めるときのセーフゾーンの、水平の半分の幅（マス）です。生成用より広くします。"
OriginDespawnSafeHeightCellsToolTip<public><localizes>:message = "消すかどうかを決めるときのセーフゾーンの、上下の半分の高さ（マス）です。生成用より広くします。"
OriginDespawnDeadHalfCellsToolTip<public><localizes>:message = "消すかどうかを決めるときのデッドゾーンの、水平の半分の幅（マス）です。セーフゾーンがこの外へはみ出したときだけ、消す範囲を置き直します。"
OriginDespawnDeadHeightCellsToolTip<public><localizes>:message = "消すかどうかを決めるときのデッドゾーンの、上下の半分の高さ（マス）です。"
SpawnerStartOnBeginToolTip<public><localizes>:message = "オンなら、ゲームの始めから出し入れします。オフなら、起動の合図（activated_event）が届いてから出し入れし、停止の合図で止まって全部消します。"
SpawnerFitToAreaToolTip<public><localizes>:message = "オンなら、借りた範囲いっぱいの大きさに伸ばして置きます（メッシュの大きさ 1 のときの 1 辺を下の値に入れます）。オフなら prefab のままの大きさで、範囲の真ん中に置きます。"
SpawnerMeshSizeToolTip<public><localizes>:message = "メッシュの大きさ 1 のときの 1 辺の長さ（センチメートル）です。エンジンの基本のキューブなら 100 です。範囲いっぱいに伸ばすときに使います。"
SpawnerPlaceCategory<public><localizes>:message = "置き方"
SpawnerLevelIntervalToolTip<public><localizes>:message = "0 より大きければ、高さをこのマス数ごとの段に決め、1 つの段に 1 つだけ出します（一度出した段は、消えても出し直しません）。0 なら高さもランダムです。既定 0"
SpawnPrefabCategory<public><localizes>:message = "prefab を出す"
SpawnPrefabToolTip<public><localizes>:message = "出す prefab を選びます。出したものはこの entity の子になります。既定の entity のままだと、何も無い entity を出すだけです。"
SpawnPrefabOnActivateToolTip<public><localizes>:message = "起動の合図（ゲームの流れなら、このノードに入ったとき）が届くたびに出す数です。0 なら起動の合図では出しません（コードから出します）。"
SpawnPrefabMaxCountToolTip<public><localizes>:message = "同時に出しておける数の上限です。届いたらそれ以上は出しません。0 なら上限はありません。"
SpawnPrefabPointOrderToolTip<public><localizes>:message = "子に置いた「出す場所」（spawn_point_component）をどの順に使うかです。InOrder は「順番」の小さい順に 1 つずつ、Random は毎回ランダムです。出す場所が無ければ、この entity の位置に出します。"
SpawnPrefabScatterToolTip<public><localizes>:message = "出す場所から、前・左・上それぞれ ± この長さ（センチメートル）の箱の中に、ランダムにずらして出します。0 の軸はずらしません。"
SpawnPrefabDespawnOnDeactivateToolTip<public><localizes>:message = "オンなら、停止の合図（ゲームの流れなら、このノードを出たとき）で出したものを全部消します。オフなら停止の合図では消しません。"
SpawnPointOrderToolTip<public><localizes>:message = "親の「prefab を出す」の使う順が InOrder のときの順番です。数字の小さい場所から使います。"
