HoverCategory<public><localizes>:message = "Hover"
HoverMaxFallSpeedToolTip<public><localizes>:message = "Fall speed cap while hovering (centimeters per second). 0 holds the current height."
HoverEnergyPerSecondToolTip<public><localizes>:message = "Energy used per second while hovering. It is taken from the energy_component on this entity or a child (otherwise the one attached to the player); hovering is impossible at 0. Without energy, hovering consumes nothing."
HoverActionToolTip<public><localizes>:message = "Input (Input Action) held in the air to hover. Default is Jump."
HoverMappingToolTip<public><localizes>:message = "Key mapping (Input Mapping) enabled while granted. Choose one that contains the input above. Default is TraversalMapping (the movement inputs)."
HoverRemoveMappingToolTip<public><localizes>:message = "When on, the key mapping above is removed on revoke (for an item, when unequipped). Turn this on only when you chose a mapping dedicated to this ability. Turning it on with the default TraversalMapping also disables the movement inputs."
HoverInputCategory<public><localizes>:message = "Input"
