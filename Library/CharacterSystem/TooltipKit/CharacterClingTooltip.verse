CharacterClingCategory<public><localizes>:message = "Clinging to walls and ceilings"
ClingRequiresGrantToolTip<public><localizes>:message = "When on, clinging is possible only while a modifier that grants cling is stacked on the body (a pickup ability. GrantCling of BuffKit's character_move_grant_component). When the grant is removed, a clinging body lets go and falls. When off, clinging is always possible. Default on"
ClingWallToolTip<public><localizes>:message = "When on, pushing input toward a wall (non-walkable surface) attaches to it. Default on"
ClingCeilingToolTip<public><localizes>:message = "When on, hitting a ceiling (downward-facing surface) while rising attaches to it. Climbing a wall into a ceiling also moves onto the ceiling. Default on"
ClingAttachFromGroundToolTip<public><localizes>:message = "When on, holding input toward a wall while standing on the ground also attaches (after GroundAttachDelaySeconds). When off, attaches only in the air. Default on"
ClingGroundAttachDelayToolTip<public><localizes>:message = "Time (seconds) to hold input toward a wall before attaching from the ground. Prevents climbing after merely grazing a wall. 0 attaches at once. In the air, attaching is immediate. Default 0.15"
ClingClimbSpeedToolTip<public><localizes>:message = "Crawl speed on walls (cm/s). Input toward the wall goes up, away goes down, side input moves sideways along the wall. The speed multiplier of the modifiers on the body also applies. Default 400"
ClingCeilingSpeedToolTip<public><localizes>:message = "Crawl speed on ceilings (cm/s). Moves horizontally in the same input direction as walking. Stops without input. The speed multiplier of the modifiers on the body also applies. Default 350"
ClingAccelerationToolTip<public><localizes>:message = "Acceleration toward the crawl speed (cm/s^2). The momentum at the moment of attaching also drops to the crawl speed at this rate. 0 reaches the speed at once. Default 4000"
ClingWallSlideToolTip<public><localizes>:message = "Slide-down speed on a wall without input (cm/s). 0 stays still while clinging. Default 50"
ClingWallJumpAwayToolTip<public><localizes>:message = "Speed away from the wall when jumping off a wall (cm/s). Default 600"
ClingWallJumpUpToolTip<public><localizes>:message = "Upward speed when jumping off a wall (cm/s). The jump multiplier of the modifiers on the body also applies. Default 850"
ClingCeilingDropToolTip<public><localizes>:message = "Downward speed when pressing jump on a ceiling to let go (cm/s). 0 falls by gravity alone. Default 0"
ClingLedgeHopUpToolTip<public><localizes>:message = "Upward speed of the small hop onto the ledge when climbing a wall reaches its top edge (cm/s). Default 500"
ClingLedgeHopForwardToolTip<public><localizes>:message = "Speed toward the wall (onto the ledge) of the small hop when climbing a wall reaches its top edge (cm/s). Default 300"
ClingContactGraceToolTip<public><localizes>:message = "Time (seconds) from losing the surface being clung to until letting go. Prevents letting go at small gaps and steps in the surface. Default 0.15"
ClingAwayDetachToolTip<public><localizes>:message = "Holding input away from the wall for this time (seconds) lets go (a short push just crawls down). 0 never lets go by input (only by jumping, the edge of the surface, or losing the grant). Default 0.4"
ClingReattachCooldownToolTip<public><localizes>:message = "Time (seconds) after jumping, letting go or hopping onto a ledge before attaching again. Prevents re-attaching to the same wall the moment you jump off it. Default 0.25"
ClingFollowOuterCornersToolTip<public><localizes>:message = "When on, crawling sideways on a wall onto a convex (outer) corner wraps around it onto the adjacent wall. When off, lets go and falls at the corner. Concave (inner) corners move onto the adjacent wall either way. Default on"
MoveGrantClingToolTip<public><localizes>:message = "When on, lets a body carrying ClingKit's cling component (RequiresGrant on) cling to walls and ceilings (the slime ability). When removed, a clinging body lets go and falls. Default off"
