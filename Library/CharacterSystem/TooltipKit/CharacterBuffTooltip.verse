CharacterBuffCategory<public><localizes>:message = "独自キャラクターのバフ・能力の付与"
BuffSpeedToolTip<public><localizes>:message = "歩く・走る速さの上限に掛ける倍率です（1.5 で 1.5 倍）。重ねると掛け合わせます。既定 1"
BuffJumpToolTip<public><localizes>:message = "跳ぶ瞬間の上向きの速さに掛ける倍率です（高さはおよそ 2 乗で変わります）。重ねると掛け合わせます。既定 1"
BuffGravityToolTip<public><localizes>:message = "重力に掛ける倍率です（0.5 でふんわり落ち、0 で落ちません）。重ねると掛け合わせます。既定 1"
BuffOverrideSideStyleToolTip<public><localizes>:message = "オンなら、重ねているあいだ、歩く部品の左右の入力のしかたを SideStyle にします（拾うとカニ歩き・その場で回るに変わる効果など）。いくつも重なれば最後に重ねたものが勝ち、全部外れると歩く部品の基本に戻ります。既定 オフ"
BuffSideStyleToolTip<public><localizes>:message = "OverrideSideStyle がオンのとき、重ねているあいだの左右の入力のしかたです。Turn は動く向きへ回る、Strafe は前を向いたまま横へ動く（カニ歩き）、TankTurn は左右でその場で回り前後は体の向きへ動く。既定 Strafe"
BuffActiveOnBeginToolTip<public><localizes>:message = "オンなら、起動の合図を待たずに開始から効かせます。オフなら起動の合図から停止の合図まで（PickupSystem の効果のプレハブ・ロードアウトの中ならオフのまま）。既定 オフ"
MoveGrantAirJumpsToolTip<public><localizes>:message = "空中ジャンプの回数に足す数です（2 段ジャンプにするなら 1）。空中で増えたら、増えた分をすぐ使えます。既定 1"
MoveGrantDashToolTip<public><localizes>:message = "オンなら、ダッシュの部品の RequiresGrant がオンの体でもダッシュできるようにします（ダッシュの部品と入力は体に置いておく）。既定 オフ"
