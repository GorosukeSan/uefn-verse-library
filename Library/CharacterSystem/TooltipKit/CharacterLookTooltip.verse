CharacterLookCategory<public><localizes>:message = "Custom character visual motion (squash and stretch)"
LookShellToolTip<public><localizes>:message = "The shell entity to squash and stretch (a descendant of the body. Put the mesh origin at the feet = bottom center). The position, rotation and scale placed in the editor are the base shape. Does nothing if empty."
LookCoreToolTip<public><localizes>:message = "The core entity kept at the center of the deformed shell (place it as a child of the same parent as the shell). If empty, only the shell moves."
LookMeshHeightToolTip<public><localizes>:message = "Height of the core mesh at scale 1 (cm). Used to find the center of the core. Default 100"
LookMeshPivotAtBottomToolTip<public><localizes>:message = "When on, the core mesh's origin is at the bottom center (the center is half the height x the core's scale above the origin). When off, the origin is the center. Default on"
LookCoreDeformRatioToolTip<public><localizes>:message = "Fraction by which the core also follows the shell's deformation (0 keeps the core's scale, 1 deforms as much as the shell). Default 0"
LookSpringStiffnessToolTip<public><localizes>:message = "Stiffness of the spring that returns the shape to its target. Higher returns faster. Default 260"
LookSpringDampingToolTip<public><localizes>:message = "Damping of the spring. Lower overshoots and jiggles; around 2 x sqrt(stiffness) returns without oscillating. Default 14"
LookPreserveVolumeToolTip<public><localizes>:message = "When on, the three axis factors are normalized so their product is 1 (stretching vertically gets thinner, squashing gets fatter). Default on"
LookPulseHoldToolTip<public><localizes>:message = "Seconds to hold the jump / landing / wall shape. Then it springs back. Default 0.05"
LookJumpScaleToolTip<public><localizes>:message = "Shape at the moment of jumping from the ground (forward, left, up factors). Default (0.8, 0.8, 1.3)"
LookAirJumpScaleToolTip<public><localizes>:message = "Shape at the moment of an air jump (forward, left, up factors). Default (0.75, 0.75, 1.35)"
LookLandSquashScaleToolTip<public><localizes>:message = "Shape at the moment of landing at LandFullSpeedCmPerSecond or faster (forward, left, up factors). Slower landings fall between this and the base shape. Default (1.3, 1.3, 0.65)"
LookLandMinSpeedToolTip<public><localizes>:message = "Downward landing speed at which squashing starts (cm/s). Slower landings (stepping off a step, etc.) do not squash. Default 250"
LookLandFullSpeedToolTip<public><localizes>:message = "Downward landing speed at which squashing reaches LandSquashScale (cm/s). Default 1800"
LookDashStretchToolTip<public><localizes>:message = "Amount of stretch toward the travel direction at the moment of dashing (0.45 for 1.45x). Default 0.45"
LookDashHoldToolTip<public><localizes>:message = "Seconds to hold the dash stretch (about the dash component's DurationSeconds). Default 0.15"
LookHitWallSquashToolTip<public><localizes>:message = "Amount of squash along the direction traveled before hitting a wall (0.25 for 0.75x). 0 does not squash. Default 0.25"
LookHitWallMinSpeedToolTip<public><localizes>:message = "Squashes at a wall only when the horizontal speed before the hit was at least this (cm/s). Default 350"
LookAirStretchToolTip<public><localizes>:message = "Vertical stretch in the air per 1000 cm/s of vertical speed (0.15 for 1.15x). Default 0.15"
LookAirStretchMaxToolTip<public><localizes>:message = "Maximum vertical stretch in the air (0.25 for up to 1.25x). Default 0.25"
LookRunBobAmountToolTip<public><localizes>:message = "Vertical bob while running (one side). 0 does not bob. Default 0.04"
LookRunBobStrideToolTip<public><localizes>:message = "Distance traveled per bob cycle while running (cm). Smaller bobs faster. Default 160"
LookRunFullSpeedToolTip<public><localizes>:message = "Horizontal speed (cm/s) at which bob and lean are strongest (blended from the idle breathing). Default 600"
LookRunLeanToolTip<public><localizes>:message = "Maximum lean toward the travel direction while running on the ground (degrees). Leans around the feet. 0 does not lean. Default 5"
LookIdleBreathAmountToolTip<public><localizes>:message = "Vertical squash / stretch of the idle breathing (one side). 0 does not breathe. Default 0.025"
LookIdleBreathSecondsToolTip<public><localizes>:message = "Seconds per breathing cycle. Default 2.4"
