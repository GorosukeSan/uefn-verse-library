CharacterSurfaceCategory<public><localizes>:message = "独自キャラクターが触れる面"
SurfaceSizeToolTip<public><localizes>:message = "箱の大きさ（cm。前後・左右・上下）です。すべて 0 より大きければこれを使い、entity の大きさは見ません。既定 0（entity の大きさ × MeshSizeCm）"
SurfaceMeshSizeToolTip<public><localizes>:message = "大きさ 1 のときのメッシュの一辺（cm）です。SizeCm を使わないとき、entity の大きさに掛けます。既定 100"
SurfacePivotAtBottomToolTip<public><localizes>:message = "オンなら entity の位置を箱の底面の真ん中とします（底が原点のメッシュ）。オフなら箱の真ん中。既定 オン"
TouchMarginToolTip<public><localizes>:message = "体の箱に足す余白（cm）です。体は面の手前 2 cm で止まるので、それより大きくします。既定 8"
TouchStandToleranceToolTip<public><localizes>:message = "足元の高さが面の上面からこの距離（cm）以内なら「乗っている」とします。既定 15"
TouchSearchRadiusToolTip<public><localizes>:message = "足元からこの距離（cm）以内の面だけを候補にします。既定 3000"
TouchRefreshToolTip<public><localizes>:message = "候補の面を探し直す間隔（秒）です。既定 0.5"
RideMaxCarryToolTip<public><localizes>:message = "1 フレームにこれ（cm）より大きく動いた床には付いていきません（ワープ・やり直しで連れて行かれないように）。既定 300"
RideGraceToolTip<public><localizes>:message = "接地が一瞬切れても、足元のすぐ下にまだ同じ床があれば、この秒数までは乗っているとして運び続けます（ジャンプで離れたときは使いません）。0 で使いません。既定 0.1"
RideInheritVelocityToolTip<public><localizes>:message = "オンなら、動く床から離れたとき（ジャンプ・縁から落ちた）に床の速度（下向きは除く）を体に足し、床と一緒に進みます。空中から乗ったときは、受け継いでいた分を消します（床の上で滑らない）。既定 オン"
RideFollowYawToolTip<public><localizes>:message = "オンなら、乗っている面が回ったとき（ヨー）、体の位置も面のまわりに同じだけ回して運びます（体の向きは変えません）。オフなら面の位置の動きだけを運びます。既定オン"
