CharacterMotorCategory<public><localizes>:message = "独自キャラクターの体"
MotorRadiusToolTip<public><localizes>:message = "体のカプセルの半径（cm）です。既定 40"
MotorHeightToolTip<public><localizes>:message = "体のカプセルの高さ（cm。足元から頭まで）です。既定 180"
MotorGravityToolTip<public><localizes>:message = "重力の加速度（cm/s²）です。既定 1960"
MotorMaxFallToolTip<public><localizes>:message = "落ちる速さの上限（cm/s）です。既定 4000"
MotorMaxSlopeToolTip<public><localizes>:message = "立っていられる坂の角度の上限（度）です。これより急な面は壁として滑ります。既定 50"
MotorGroundProbeToolTip<public><localizes>:message = "足元から下へ地面を探す距離（cm）です。この距離までに地面があれば吸い付きます。既定 10"
MotorMovingSpeedToolTip<public><localizes>:message = "水平の速さがこれを超えたら「動いている」とします（cm/s）。既定 10"
MotorSpawnAtOwnerToolTip<public><localizes>:message = "オンなら、開始時に持ち主の Fortnite キャラクターの位置へ移ります。既定 オン"
MotorAxisLockToolTip<public><localizes>:message = "動ける向きを平面に縛ります。Left なら左右の位置を保ち、前後と上下だけで動きます（横スクロールの 2D）。既定 None"
CharacterWalkCategory<public><localizes>:message = "歩く"
WalkMoveActionToolTip<public><localizes>:message = "方向の入力（前後・左右。input_action(vector3)）です。使わなければ空にします。"
WalkButtonToolTip<public><localizes>:message = "この向きへ進むボタン（input_action(logic)）です。使わなければ空にします。"
WalkSprintActionToolTip<public><localizes>:message = "押しているあいだ走るボタンです。使わなければ空にします。"
WalkSpaceToolTip<public><localizes>:message = "歩く向きを何に合わせるかです。View は持ち主の視点、World は世界の向き（見下ろし型）、Facing はキャラクターの向き、SideView は横スクロール（入力の左右で前後に動く）。既定 View"
WalkMaxSpeedToolTip<public><localizes>:message = "歩く速さの上限（cm/s）です。既定 600"
WalkAccelerationToolTip<public><localizes>:message = "加速（cm/s²）です。既定 4000"
WalkBrakingToolTip<public><localizes>:message = "入力が無いときの減速（cm/s²）です。既定 5000"
WalkAirControlToolTip<public><localizes>:message = "空中で入力の向きへ加速するときの、加速に掛ける倍率です（0 で空中では操作できない、1 で地上と同じ）。入力が無いときの減速は AirBrakingRatio。既定 0.6"
WalkAirBrakingToolTip<public><localizes>:message = "空中で入力が無いときの、減速に掛ける倍率です（0 で減速しない、1 で地上と同じ）。小さいほど跳んだ勢いが残ります。既定 0.2（600 cm/s が約 0.6 秒で止まる）"
WalkAirTurnAroundToolTip<public><localizes>:message = "空中の切り返しのとき、空中の加速に掛ける倍率の上限です（地上の TurnAroundMultiplier の代わり）。入力が今の動きと逆向きなほど大きく掛かります（真横で 1 倍、真逆でこの倍率）。大きいほど空中で向きを変えやすくなります。既定 2"
WalkKeepAirMomentumToolTip<public><localizes>:message = "オンなら、空中で歩く速さの上限より速い分（はじき・打ち上げで得た速さ）を、入力の向きへ曲げるだけで減らしません（逆向きに入れたときだけ減ります）。入力で上限より速くはなりません。ダッシュの速さは、ダッシュが終わるときに上限までに切るので残りません。オフなら空中でも上限まで減らします。既定 オン"
WalkSprintMultiplierToolTip<public><localizes>:message = "走るときの速さの倍率です。既定 1.6"
WalkSideStyleToolTip<public><localizes>:message = "左右の入力でどうするかです。Turn は左右へ動き体は動く向きへ回る、Strafe は左右へ動くが体は前（Space = View なら視点の向き）を向いたまま（カニ歩き）、TankTurn は左右ではその場で回り前後は体の向きへ動く（Space は使わない）。体に重ねた変更（バフ）が決めているあいだはそちらが優先です。既定 Turn"
WalkTankTurnSpeedToolTip<public><localizes>:message = "TankTurn のとき、左右の入力で 1 秒に回る角度（度）です。既定 180"
WalkSideStyleToggleActionToolTip<public><localizes>:message = "押すたびに、左右の入力のしかたを SideStyle と ToggleSideStyle で切り替えるボタン（input_action(logic)）です。使わなければ空にします。"
WalkToggleSideStyleToolTip<public><localizes>:message = "切り替えのボタンで切り替える先の、左右の入力のしかたです。既定 Strafe"
CharacterJumpCategory<public><localizes>:message = "ジャンプ"
JumpActionToolTip<public><localizes>:message = "ジャンプのボタン（input_action(logic)）です。既定は Fortnite のジャンプ。"
JumpSpeedToolTip<public><localizes>:message = "跳んだ瞬間の上向きの速さ（cm/s）です。既定 900"
JumpAirJumpsToolTip<public><localizes>:message = "空中で跳べる回数です（2 段ジャンプなら 1）。既定 0"
JumpCoyoteToolTip<public><localizes>:message = "歩いて地面を離れてからも、地面のジャンプとして跳べる時間（秒）です（コヨーテタイム）。自分のジャンプで離れたときは使えません。空中ジャンプの回数は減りません。0 で使いません。既定 0.12"
JumpBufferToolTip<public><localizes>:message = "着地より前に押したジャンプを覚えておき、着地した瞬間に跳ぶ時間（秒）です（先行入力）。空中ジャンプが残っていれば、押したときに空中ジャンプになります。0 で使いません。既定 0.12"
JumpReleaseCutToolTip<public><localizes>:message = "跳んでから上がっている途中で離したときに、上向きの速さに掛ける倍率です（短く押すと低く跳ぶ。1 なら変えない）。コードの Jump は ReleaseJump を呼ぶまで押しているとみなします。既定 0.5"
CharacterDashCategory<public><localizes>:message = "ダッシュ"
DashActionToolTip<public><localizes>:message = "ダッシュのボタン（input_action(logic)）です。使わなければ空にします。"
DashSpeedToolTip<public><localizes>:message = "突進の速さ（cm/s）です。突進の時間と掛けた距離だけ進みます。既定 2200"
DashDurationToolTip<public><localizes>:message = "突進の時間（秒）です。既定 0.18（既定の速さで 396 cm）"
DashEndSpeedRatioToolTip<public><localizes>:message = "突進が終わったとき、ダッシュの向きの速さを落とす先の倍率です（歩く速さの上限に掛ける。1 なら歩く速さの上限まで、0 ならその場で止まる）。突進の速さは残りません。既定 1"
DashGravityScaleToolTip<public><localizes>:message = "突進のあいだ重力に掛ける倍率です（0 なら空中のダッシュは高さが変わらない、1 なら普段どおり落ちる）。既定 0"
DashCooldownToolTip<public><localizes>:message = "次に出せるまでの時間（秒。出した瞬間から数える）です。既定 0.8"
DashAirDashesToolTip<public><localizes>:message = "空中で出せる回数です。地面に降りると戻ります。既定 1"
DashEnergyCostToolTip<public><localizes>:message = "1 回に使うエネルギーです（0 なら使わない）。足りなければ出せません。既定 0"
CharacterBodyCategory<public><localizes>:message = "独自キャラクターの見た目・操作"
FaceTurnSpeedToolTip<public><localizes>:message = "体の向きを 1 秒に回る角度（度）です。0 ならすぐ向きます。向ける先は歩く部品の左右の入力のしかたで決まります（Turn は動いている方向、Strafe は歩く向きの前、TankTurn は回さない）。既定 720"
FaceAirFacesInputToolTip<public><localizes>:message = "オンなら、Turn のとき、空中では動いている方向ではなく入力の向きへ回します（入力が無ければ向きを変えません。動く床から受け継いだ勢い・はじかれた向きへは回りません）。オフなら空中でも動いている方向へ。既定 オン"
InputMappingsToolTip<public><localizes>:message = "持ち主に足す入力の割り当て（独自キャラクターのボタン・方向の入力を入れたもの）です。"
InputMappingsRemoveToolTip<public><localizes>:message = "オンなら、止まるときに外します。Fortnite の割り当て（TraversalMapping など）を入れたときはオフにします。既定 オン"
CharacterEventCategory<public><localizes>:message = "独自キャラクターへの反応"
ActionTriggerActionToolTip<public><localizes>:message = "見張ることです（着地・ジャンプ・空中ジャンプ・ダッシュ・地面から離れた・動き始め・止まった・壁に当たった）。既定 Landed"
ActionTriggerTargetsToolTip<public><localizes>:message = "起きたときに起動の合図を送る entity です。空なら、この entity とその子孫へ送ります。"
ActionTriggerCooldownToolTip<public><localizes>:message = "次を無視する時間（秒）です。0 なら無視しません。既定 0"
MotorConditionStateToolTip<public><localizes>:message = "満たす状態です（地面・空中・上昇・落下・動いている・止まっている）。既定 Airborne"
CharacterCameraCategory<public><localizes>:message = "独自キャラクターのカメラ（実験的）"
CameraRigToolTip<public><localizes>:message = "カメラの動かし方。Orbit（既定）は持ち主が視点の入力でキャラクターの周りを回せます。Fixed は決めた位置・向きで付いていきます（横スクロールなど）。"
CameraOrbitDistanceToolTip<public><localizes>:message = "Orbit のとき、回る中心からカメラまでの距離（cm）。"
CameraOrbitHeightToolTip<public><localizes>:message = "Orbit のとき、回る中心の、キャラクターの足元からの高さ（cm）。"
CameraOrbitCollisionToolTip<public><localizes>:message = "Orbit のとき、オンならカメラが壁などにめり込まないよう近づけます。既定 オフ（v43.00 では、オンにすると接地中に一人称になることがあります）"
CameraProjectionToolTip<public><localizes>:message = "写し方です。Perspective は遠近のある 3D、Orthographic は遠近の無い 2D・見下ろし型。既定 Perspective"
CameraOffsetToolTip<public><localizes>:message = "カメラの位置です（キャラクターの足元からのずらし、cm）。既定は後ろ 600・上 250"
CameraYawToolTip<public><localizes>:message = "カメラの水平の向き（度）です。写る向きが違うときに合わせます。既定 0"
CameraPitchToolTip<public><localizes>:message = "カメラの上下の向き（度。負で見下ろす）です。既定 -15"
CameraFieldOfViewToolTip<public><localizes>:message = "遠近のある写し方の水平の画角（度）です。既定 90"
CameraOrthographicWidthToolTip<public><localizes>:message = "遠近の無い写し方で、画面の横幅に写る長さ（cm）です。既定 3000"
CameraPriorityToolTip<public><localizes>:message = "ほかのカメラより優先する度合いです（大きいほど優先）。既定 10"
MotorResetOnRoundToolTip<public><localizes>:message = "オンなら、Fortnite のラウンドが始まるたびに、速度を消して持ち主の Fortnite キャラクターの位置へ移ります（ラウンドごとにスタートからやり直す）。既定 オン"
DashRequiresGrantToolTip<public><localizes>:message = "オンなら、体に「ダッシュを許す変更」が重なっているあいだだけ出せます（拾うと使える能力にする。BuffKit の character_move_grant_component の GrantDash）。既定 オフ"
MotorFallGravityToolTip<public><localizes>:message = "下がっているときの重力に掛ける倍率です。上がるときより速く落ちて、ふわっとしなくなります。縁から歩いて落ちたときにも掛かります。1 なら上がるときと同じ。既定 1.6"
MotorGroundSnapToolTip<public><localizes>:message = "地面にいた体が、地面に沿って動いているとき（ジャンプで離れていないとき）に下へ探す距離（cm）です。坂を下る・低い段を降りるときに浮かずに吸い付きます。GroundProbeCm より小さければ GroundProbeCm を使います。0 で使いません。既定 20"
MotorStepUpToolTip<public><localizes>:message = "地面にいて水平に動いているときに、足元が段の角に当たったら乗り上げる高さの上限（cm）です。階段で使います。空中では使いません（空中は LedgeAssistCm）。0 で使いません。既定 15"
MotorLedgeAssistToolTip<public><localizes>:message = "空中で下がっているときに、足元が縁の角に当たったら乗り上げる高さの上限（cm）です。ジャンプが少し届かなかった縁に乗れます。0 で使いません。既定 0"
MotorCornerCorrectionToolTip<public><localizes>:message = "上がっている途中で頭が天井（下向きの面）の角にかすったとき、横へずらして上がり続ける距離の上限（cm）です。速度は落ちません。壁には使いません。0 で使いません。既定 12"
WalkTurnAroundToolTip<public><localizes>:message = "地面の切り返し（入力の向きが今の動きと逆向き）のとき、加速に掛ける倍率です。止まってから動き直すより早く向きを変えられます。1 なら普通の加速と同じ。空中は AirTurnAroundMultiplier。既定 2"
JumpApexSpeedToolTip<public><localizes>:message = "頂点の浮き：跳んでから押したまま、上下の速さがこれより遅いあいだ重力を弱めます（cm/s）。頂点で少し長く浮いて、着地点を合わせやすくなります。0 で使いません。既定 150"
JumpApexGravityToolTip<public><localizes>:message = "頂点の浮きのあいだ、重力に掛ける倍率です（体の FallGravityMultiplier の代わりに使います）。1 なら弱めません。既定 0.5"
