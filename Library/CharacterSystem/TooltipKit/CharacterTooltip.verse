CharacterMotorCategory<public><localizes>:message = "Custom character body"
MotorRadiusToolTip<public><localizes>:message = "Radius of the body capsule (cm). Default 40"
MotorHeightToolTip<public><localizes>:message = "Height of the body capsule (cm, feet to head). Default 180"
MotorGravityToolTip<public><localizes>:message = "Gravitational acceleration (cm/s^2). Default 1960"
MotorMaxFallToolTip<public><localizes>:message = "Maximum fall speed (cm/s). Default 4000"
MotorMaxSlopeToolTip<public><localizes>:message = "Maximum slope angle you can stand on (degrees). Steeper surfaces slide as walls. Default 50"
MotorGroundProbeToolTip<public><localizes>:message = "Distance to probe down from the feet for ground (cm). Snaps if ground is within this distance. Default 10"
MotorMovingSpeedToolTip<public><localizes>:message = "Counts as moving when the horizontal speed exceeds this (cm/s). Default 10"
MotorSpawnAtOwnerToolTip<public><localizes>:message = "When on, moves to the owner's Fortnite character at start. Default on"
MotorAxisLockToolTip<public><localizes>:message = "Restricts movement to a plane. Left keeps the Left position and moves only along Forward and up / down (side-scrolling 2D). Default None"
CharacterWalkCategory<public><localizes>:message = "Walk"
WalkMoveActionToolTip<public><localizes>:message = "Direction input (forward / back, left / right. input_action(vector3)). Leave empty if unused."
WalkButtonToolTip<public><localizes>:message = "Button to move in this direction (input_action(logic)). Leave empty if unused."
WalkSprintActionToolTip<public><localizes>:message = "Button to run while held. Leave empty if unused."
WalkSpaceToolTip<public><localizes>:message = "What the walking direction is aligned to. View is the owner's view, World is the world axes (top-down), Facing is the character's facing, SideView is a side-scroller (side input moves forward / back). Default View"
WalkMaxSpeedToolTip<public><localizes>:message = "Walking speed cap (cm/s). Default 600"
WalkAccelerationToolTip<public><localizes>:message = "Acceleration (cm/s^2). Default 4000"
WalkBrakingToolTip<public><localizes>:message = "Braking without input (cm/s^2). Default 5000"
WalkAirControlToolTip<public><localizes>:message = "Multiplier on acceleration when accelerating toward the input direction in the air (0: no air control, 1: same as the ground). Braking without input is AirBrakingRatio. Default 0.6"
WalkAirBrakingToolTip<public><localizes>:message = "Multiplier on braking without input in the air (0: no braking, 1: same as the ground). Smaller keeps more of the jump momentum. Default 0.2 (600 cm/s stops in about 0.6 s)"
WalkAirTurnAroundToolTip<public><localizes>:message = "Upper bound of the multiplier on air acceleration on an air turnaround (instead of the ground's TurnAroundMultiplier). The more the input opposes the current motion, the more applies (1x at a right angle, this multiplier when fully opposed). Higher makes it easier to change direction in the air. Default 2"
WalkKeepAirMomentumToolTip<public><localizes>:message = "When on, speed above the walking speed cap in the air (gained from knockback or a launch) is only bent toward the input direction, never reduced (reduced only when the input opposes it). Input never exceeds the cap. Dash speed does not remain, because dash cuts it to the cap when it ends. When off, reduces to the cap in the air too. Default on"
WalkSprintMultiplierToolTip<public><localizes>:message = "Speed multiplier while running. Default 1.6"
WalkSideStyleToolTip<public><localizes>:message = "What to do with side input. Turn moves sideways and turns the body toward the movement; Strafe moves sideways while the body keeps facing forward (the view direction when Space = View) (crab walk); TankTurn turns in place with side input and moves forward / back along the body's facing (Space is not used). While a modifier (buff) on the body decides it, that takes precedence. Default Turn"
WalkTankTurnSpeedToolTip<public><localizes>:message = "With TankTurn, degrees turned per second by side input. Default 180"
WalkSideStyleToggleActionToolTip<public><localizes>:message = "Button (input_action(logic)) that toggles the side-input style between SideStyle and ToggleSideStyle on each press. Leave empty if unused."
WalkToggleSideStyleToolTip<public><localizes>:message = "The side-input style the toggle button switches to. Default Strafe"
CharacterJumpCategory<public><localizes>:message = "Jump"
JumpActionToolTip<public><localizes>:message = "Jump button (input_action(logic)). Default is Fortnite's jump."
JumpSpeedToolTip<public><localizes>:message = "Upward speed at the moment of jumping (cm/s). Default 900"
JumpAirJumpsToolTip<public><localizes>:message = "Number of jumps in the air (1 for a double jump). Default 0"
JumpCoyoteToolTip<public><localizes>:message = "Time (seconds) after walking off the ground during which a jump still counts as a ground jump (coyote time). Not available after leaving by your own jump. Does not consume air jumps. 0 disables. Default 0.12"
JumpBufferToolTip<public><localizes>:message = "Time (seconds) to remember a jump pressed before landing and jump at the moment of landing (input buffering). With air jumps remaining, the press becomes an air jump instead. 0 disables. Default 0.12"
JumpReleaseCutToolTip<public><localizes>:message = "Multiplier on the upward speed when the button is released while rising after a jump (a short press jumps lower. 1 leaves it unchanged). Jump from code counts as held until ReleaseJump is called. Default 0.5"
CharacterDashCategory<public><localizes>:message = "Dash"
DashActionToolTip<public><localizes>:message = "Dash button (input_action(logic)). Leave empty if unused."
DashSpeedToolTip<public><localizes>:message = "Dash speed (cm/s). Travels this times the dash duration. Default 2200"
DashDurationToolTip<public><localizes>:message = "Dash duration (seconds). Default 0.18 (396 cm at the default speed)"
DashEndSpeedRatioToolTip<public><localizes>:message = "Multiplier that the speed along the dash direction is cut to when the dash ends (applied to the walking speed cap. 1 cuts to the walking speed cap, 0 stops on the spot). No dash speed is kept. Default 1"
DashGravityScaleToolTip<public><localizes>:message = "Multiplier on gravity during the dash (0: an air dash keeps its height, 1: falls as usual). Default 0"
DashCooldownToolTip<public><localizes>:message = "Time until the next dash (seconds, counted from the moment of dashing). Default 0.8"
DashAirDashesToolTip<public><localizes>:message = "Number of dashes allowed in the air. Restored on landing. Default 1"
DashEnergyCostToolTip<public><localizes>:message = "Energy spent per dash (0 spends none). Cannot dash without enough. Default 0"
CharacterBodyCategory<public><localizes>:message = "Custom character look and control"
FaceTurnSpeedToolTip<public><localizes>:message = "Degrees per second the body turns. 0 faces instantly. Where it faces is decided by the walk component's side-input style (Turn: the movement direction, Strafe: the front of the walking direction, TankTurn: not turned). Default 720"
FaceAirFacesInputToolTip<public><localizes>:message = "When on, with Turn, in the air turns toward the input direction instead of the movement direction (unchanged without input. Does not turn toward momentum inherited from a moving floor or a knockback direction). When off, toward the movement direction in the air too. Default on"
InputMappingsToolTip<public><localizes>:message = "Input mapping added to the owner (holding the custom character's button / direction inputs)."
InputMappingsRemoveToolTip<public><localizes>:message = "When on, removed when stopped. Turn it off for Fortnite mappings (TraversalMapping, etc.). Default on"
CharacterEventCategory<public><localizes>:message = "Reactions to the custom character"
ActionTriggerActionToolTip<public><localizes>:message = "What to watch for (landed, jumped, air jumped, dashed, left the ground, started moving, stopped, hit a wall, clung to a wall or ceiling, released from a cling). Default Landed"
ActionTriggerTargetsToolTip<public><localizes>:message = "Entities to send the activation signal to when it happens. If empty, sends to this entity and its descendants."
ActionTriggerCooldownToolTip<public><localizes>:message = "Time to ignore further occurrences (seconds). 0 never ignores. Default 0"
MotorConditionStateToolTip<public><localizes>:message = "State to satisfy (grounded, airborne, rising, falling, moving, still, clinging to a wall or ceiling). Default Airborne"
CharacterCameraCategory<public><localizes>:message = "Custom character camera (experimental)"
CameraRigToolTip<public><localizes>:message = "How the camera moves. Orbit (default) lets the owner orbit around the character with the view input. Fixed follows at a fixed position and rotation (side-scrollers, etc.)."
CameraOrbitDistanceToolTip<public><localizes>:message = "With Orbit, the distance from the orbit center to the camera (cm)."
CameraOrbitHeightToolTip<public><localizes>:message = "With Orbit, the height of the orbit center above the character's feet (cm)."
CameraOrbitCollisionToolTip<public><localizes>:message = "With Orbit, when on, pulls the camera closer so it does not clip into walls. Default off (in v43.00, turning it on can give first person while grounded)"
CameraProjectionToolTip<public><localizes>:message = "Projection. Perspective is 3D with perspective, Orthographic is 2D / top-down without perspective. Default Perspective"
CameraOffsetToolTip<public><localizes>:message = "Camera position (offset from the character's feet, cm). Default 600 behind, 250 up"
CameraYawToolTip<public><localizes>:message = "Horizontal camera rotation (degrees). Adjust when the view faces the wrong way. Default 0"
CameraPitchToolTip<public><localizes>:message = "Vertical camera rotation (degrees. Negative looks down). Default -15"
CameraFieldOfViewToolTip<public><localizes>:message = "Horizontal field of view for the perspective projection (degrees). Default 90"
CameraOrthographicWidthToolTip<public><localizes>:message = "Length shown across the screen width in the orthographic projection (cm). Default 3000"
CameraPriorityToolTip<public><localizes>:message = "Priority over other cameras (higher wins). Default 10"
MotorResetOnRoundToolTip<public><localizes>:message = "When on, clears velocity and moves to the owner's Fortnite character whenever a Fortnite round starts (restart from the start each round). Default on"
DashRequiresGrantToolTip<public><localizes>:message = "When on, dashing is possible only while a modifier that grants dash is stacked on the body (a pickup ability. GrantDash of BuffKit's character_move_grant_component). Default off"
MotorFallGravityToolTip<public><localizes>:message = "Multiplier on gravity while falling. Falls faster than it rises, less floaty. Also applies when walking off an edge. 1 means the same as rising. Default 1.6"
MotorGroundSnapToolTip<public><localizes>:message = "Downward probe distance (cm) for a body that was grounded and is moving along the ground (not leaving by a jump). Snaps without floating when going down slopes or low steps. GroundProbeCm is used if this is smaller. 0 disables. Default 20"
MotorStepUpToolTip<public><localizes>:message = "Maximum height (cm) of a step corner the feet may hit and climb while grounded and moving horizontally. For stairs. Not used in the air (the air uses LedgeAssistCm). 0 disables. Default 15"
MotorLedgeAssistToolTip<public><localizes>:message = "Maximum height (cm) of a ledge corner the feet may hit and climb while falling in the air. Lets you reach a ledge a jump fell slightly short of. 0 disables. Default 0"
MotorCornerCorrectionToolTip<public><localizes>:message = "Maximum sideways shift (cm) to keep rising when the head grazes the corner of a ceiling (downward-facing surface) while rising. Speed is not lost. Not used for walls. 0 disables. Default 12"
WalkTurnAroundToolTip<public><localizes>:message = "Multiplier on acceleration on a ground turnaround (input direction opposing the current motion). Changes direction faster than stopping and starting again. 1 is the same as normal acceleration. In the air, AirTurnAroundMultiplier. Default 2"
JumpApexSpeedToolTip<public><localizes>:message = "Apex hang: while held after a jump, gravity is weakened while the vertical speed is below this (cm/s). Hangs a little longer at the apex, making landings easier to aim. 0 disables. Default 150"
JumpApexGravityToolTip<public><localizes>:message = "Multiplier on gravity during the apex hang (used instead of the body's FallGravityMultiplier). 1 does not weaken. Default 0.5"
