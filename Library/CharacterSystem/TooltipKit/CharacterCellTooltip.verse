CharacterCellCategory<public><localizes>:message = "Action cells"
CellMaxCellsToolTip<public><localizes>:message = "Maximum number of cells. However many grants are stacked, never more than this. Default 6"
CellRefillOnClingToolTip<public><localizes>:message = "When on, while a timed grant (refilled on the ground) is attached, also refills the cells when clinging to a wall or ceiling. Default off"
CellGrantActionToolTip<public><localizes>:message = "The action to make usable (AirJump = air jump, Boost = boost (dash), WallKick = wall kick). Each use spends one of the body's action cells."
CellGrantCellsToolTip<public><localizes>:message = "Number of cells added to the body's action cells. The capacity grows by the same amount (up to the body's MaxCells). Default 1"
CellGrantRefillToolTip<public><localizes>:message = "When on, the cells are refilled on landing while attached (for timed effects). When off, the grant disappears once the cells are used up and the effect ends. Default off"
CellGrantActiveOnBeginToolTip<public><localizes>:message = "When on, adds the grant from start without waiting for the activation signal. Default off"
JumpWallKickReachToolTip<public><localizes>:message = "Wall kick: when jump is pressed in the air, looks for a wall within this distance (cm). Default 35"
JumpWallKickAwayToolTip<public><localizes>:message = "Wall kick: speed away from the wall (cm/s). Default 750"
JumpWallKickUpToolTip<public><localizes>:message = "Wall kick: upward speed (cm/s). The jump multiplier of the modifiers on the body also applies. Default 950"
